---
import '../styles/fonts.css'
import '../styles/styles.css'
import { SITE } from '../config/site'
import { THEME_SCRIPT } from '../lib/theme-script'
import SiteHead from '../components/SiteHead.astro'
import type { Props as HeadProps } from '../components/SiteHead.astro'
import SiteHeader from '../components/SiteHeader.astro'
import SiteMobileMenu from '../components/SiteMobileMenu.astro'
import SiteFooter from '../components/SiteFooter.astro'

// Toute la surface SEO (title, canonical, metas, OG, JSON-LD + hash CSP) est
// rendue par SiteHead, partagé avec PlaquetteLayout. Le layout ne garde que
// l'enveloppe HTML, le thème et le chrome du site.
type Props = Omit<HeadProps, 'colorScheme'>
---

<html lang={SITE.lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <!-- Anti-flash : pose data-theme avant le premier paint pour que le rendu
         initial respecte la préférence stockée / système. Inline synchrone. -->
    <script is:inline set:html={THEME_SCRIPT} />
    <SiteHead {...Astro.props} />
    <slot name="head" />
  </head>
  <body>
    <a class="skip-link" href="#main">Aller au contenu</a>
    <SiteHeader />
    <SiteMobileMenu />
    <!-- tabindex="-1" makes <main> a valid focus target so the skip link
         actually moves focus (and screen-reader virtual cursor) into the
         page content instead of just scrolling past the header. -->
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <SiteFooter />

    <script>
      // Scroll reveal — ajoute .is-visible aux éléments animés quand ils
      // entrent dans le viewport. Ignoré si prefers-reduced-motion (le CSS
      // rend alors tout visible).
      const TARGETS = '.animate-in:not(.is-visible), .card--method:not(.is-visible)'

      if (window.matchMedia('(prefers-reduced-motion: no-preference)').matches) {
        const scrollIO = new IntersectionObserver(
          (entries) => {
            entries.forEach((e) => {
              if (e.isIntersecting) {
                e.target.classList.add('is-visible')
                scrollIO.unobserve(e.target)
              }
            })
          },
          { threshold: 0.08 },
        )
        document.querySelectorAll(TARGETS).forEach(el => scrollIO.observe(el))
      }
    </script>
  </body>
</html>
