---
import '../styles/fonts.css'
import '../styles/styles.css'
import { SITE } from '../config/site'
import { THEME_SCRIPT } from '../lib/theme-script'
import SiteHead from '../components/SiteHead.astro'
import type { Props as HeadProps } from '../components/SiteHead.astro'
import SiteHeader from '../components/SiteHeader.astro'
import SiteMobileMenu from '../components/SiteMobileMenu.astro'
import SiteFooter from '../components/SiteFooter.astro'

// Toute la surface SEO (title, canonical, metas, OG, JSON-LD + hash CSP) est
// rendue par SiteHead, partagé avec PlaquetteLayout. Le layout ne garde que
// l'enveloppe HTML, le thème et le chrome du site.
type Props = Omit<HeadProps, 'colorScheme'>
---

<html lang={SITE.lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <!-- Anti-flash : pose data-theme avant le premier paint pour que le rendu
         initial respecte la préférence stockée / système. Inline synchrone. -->
    <script is:inline set:html={THEME_SCRIPT} />
    <SiteHead {...Astro.props} />
    <slot name="head" />
  </head>
  <body>
    <a class="skip-link" href="#main">Aller au contenu</a>
    <SiteHeader />
    <SiteMobileMenu />
    <!-- tabindex="-1" makes <main> a valid focus target so the skip link
         actually moves focus (and screen-reader virtual cursor) into the
         page content instead of just scrolling past the header. -->
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <SiteFooter />

    <script>
      // Scroll reveal — ajoute .is-visible une seule fois aux éléments
      // [data-reveal] / [data-reveal-stagger] qui entrent dans le viewport.
      // Les enfants d'un groupe reçoivent leur rang --i (le CSS plafonne le
      // décalage à 6). En mouvement réduit, le CSS ne garde que le fondu.
      const targets = document.querySelectorAll<HTMLElement>('[data-reveal], [data-reveal-stagger]')

      document.querySelectorAll<HTMLElement>('[data-reveal-stagger]').forEach((group) => {
        Array.from(group.children).forEach((child, i) => {
          (child as HTMLElement).style.setProperty('--i', String(i))
        })
      })

      if ('IntersectionObserver' in window) {
        const io = new IntersectionObserver(
          (entries) => {
            entries.forEach((e) => {
              if (!e.isIntersecting) return
              e.target.classList.add('is-visible')
              io.unobserve(e.target)
            })
          },
          // Déclenche quand l'élément franchit les 85 % de la hauteur d'écran :
          // équivaut à un seuil de 15 %, mais reste atteignable pour un
          // groupe plus haut que l'écran (liste longue sur mobile).
          { rootMargin: '0px 0px -15% 0px', threshold: 0 },
        )
        targets.forEach(el => io.observe(el))
      }
      else {
        targets.forEach(el => el.classList.add('is-visible'))
      }
    </script>
  </body>
</html>
