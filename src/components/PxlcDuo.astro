---
/**
 * Motif Duo (design system « PXLC 2026 ») : des paires grand/petit tirées
 * du logo, alignées ; seul le dernier petit carré est corail. Remplace
 * l'ancienne bande de pixels.
 * @usage Micro-décoration, une fois par écran au plus : en-têtes de page,
 * pied de page, menu mobile, feuilles de la plaquette.
 * @a11y Purement décoratif : SVG en aria-hidden, aucun contenu à annoncer.
 */
interface Props {
  /** Nombre de paires grand/petit. */
  count?: number
  /** Côté du petit carré, en px. */
  unit?: number
  /** Surface toujours sombre (footer, menu mobile) : grand carré en cyan. */
  onDark?: boolean
  /** Classes ajoutées au SVG (placement dans le parent). */
  class?: string
}
const { count = 3, unit = 8, onDark = false, class: className } = Astro.props

const gap = Math.round(unit / 3)
const big = 2 * unit + gap
const pitch = 3 * unit + 2 * gap + unit
const width = count * pitch - unit
const height = 3 * unit + 2 * gap
const pairs = Array.from({ length: count }, (_, i) => i * pitch)
---

<svg
  class:list={['duo', { 'duo--on-dark': onDark }, className]}
  width={width}
  height={height}
  viewBox={`0 0 ${width} ${height}`}
  aria-hidden="true"
>
  {pairs.map((x, i) => (
    <>
      <rect class="duo__big" x={x} y="0" width={big} height={big} rx={unit * 0.3} />
      <rect
        class:list={['duo__small', { 'is-accent': i === count - 1 }]}
        x={x + 2 * unit + 2 * gap}
        y={2 * unit + 2 * gap}
        width={unit}
        height={unit}
        rx={unit * 0.12}
      />
    </>
  ))}
</svg>
