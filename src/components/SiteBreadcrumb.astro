---
/**
 * Fil d'Ariane dérivé de l'URL et de la navigation.
 * @usage Pages intérieures (projets, à propos, contact) ; le JSON-LD
 * BreadcrumbList vient de la même source.
 * @a11y Nav nommée « Fil d'Ariane », liste ordonnée, dernier segment en
 * aria-current="page".
 */
import { breadcrumbItems } from '../lib/breadcrumb'

interface Props {
  /** Libellé du segment final quand il n'est pas dans la nav (ex. « Plaquette »). */
  currentLabel?: string
}
const { currentLabel } = Astro.props

// Le JSON-LD BreadcrumbList correspondant est émis dans le @graph de la page
// (src/lib/schema.ts) — même source breadcrumbItems, pas de duplication.
const crumbs = breadcrumbItems(Astro.url.pathname, currentLabel)
---

<nav class="breadcrumb" aria-label="Fil d'Ariane">
  <ol class="breadcrumb__list" role="list">
    {crumbs.map(c => (
      <li class="breadcrumb__item">
        {c.href && !c.current
          ? <a href={c.href} class="breadcrumb__link">{c.label}</a>
          : <span class="breadcrumb__current" aria-current="page">{c.label}</span>}
      </li>
    ))}
  </ol>
</nav>

<style>
  .breadcrumb { margin-bottom: var(--space-3); }
  .breadcrumb__list {
    display: flex; flex-wrap: wrap; gap: var(--space-2); align-items: center;
    list-style: none; padding: 0; margin: 0;
    font-family: var(--font-label); font-size: var(--fs-label);
    letter-spacing: var(--ls-label); text-transform: uppercase;
    color: var(--ink-quiet);
  }
  .breadcrumb__item:not(:last-child)::after {
    content: "/"; margin-left: var(--space-2); color: var(--ink-quiet);
  }
  /* Zone de tap ≥ 44 px sans grossir le libellé de 11 px. */
  .breadcrumb__link, .breadcrumb__current {
    display: inline-flex; align-items: center; min-height: 44px;
  }
  /* Survol souligné : du texte corail sur fond clair passerait sous 3:1. */
  .breadcrumb__link { color: var(--parent); }
  .breadcrumb__link:hover { text-decoration: underline; text-underline-offset: 3px; }
  .breadcrumb__current { color: var(--ink); font-weight: 600; }
</style>
