---
/**
 * Pied de page : lockup, mission, liens de contact, plan du site, mentions
 * légales et accessibilité.
 * @usage Toutes les pages, via BaseLayout.
 * @a11y Liens-icônes nommés par aria-label, icônes en aria-hidden ; liens
 * externes et PDF annoncés dans leur libellé accessible.
 */
import Calendar from '../icons/calendar.svg'
import Linkedin from '../icons/linkedin.svg'
import Mail from '../icons/mail.svg'
import MessageSquare from '../icons/message-square.svg'
import PxlcLockup from './PxlcLockup.astro'
import PxlcDuo from './PxlcDuo.astro'
import { IDENTITY } from '../config/identity'

const year = new Date().getFullYear()
---

<footer class="site-footer">
  <!-- data-nosnippet : le footer est du boilerplate sitewide ; sans cet
       attribut Google composait le snippet de l'accueil à partir de la
       mission + titres de colonnes d'ici (extrait haché). div/section/span
       sont les seuls éléments où Google honore data-nosnippet. -->
  <div class="container" data-nosnippet>
    <div class="site-footer__inner">
      <div>
        <PxlcLockup onDark />
        <p class="site-footer__mission">
          PXLC accompagne les familles autour des écrans.
        </p>
        <a class="site-footer__mission-link" href={IDENTITY.bookingUrl} target="_blank" rel="noopener noreferrer">
          Réserver un échange de 20&nbsp;min
        </a>
        <ul class="site-footer__social" role="list">
          <li>
            <a
              class="site-footer__social-btn" href="https://www.linkedin.com/company/pxlc-mediation-numerique/"
              target="_blank" rel="noopener noreferrer" aria-label="Page LinkedIn de PXLC">
              <Linkedin aria-hidden="true" />
            </a>
          </li>
          <li>
            <a class="site-footer__social-btn" href="mailto:contact@pxlc.fr" aria-label="Écrire à contact@pxlc.fr">
              <Mail aria-hidden="true" />
            </a>
          </li>
          <li>
            <a
              class="site-footer__social-btn" href={IDENTITY.bookingUrl} target="_blank" rel="noopener noreferrer"
              aria-label="Réserver un échange de 20 minutes">
              <Calendar aria-hidden="true" />
            </a>
          </li>
        </ul>
      </div>

      <div>
        <p class="site-footer__col-title">Le dispositif</p>
        <ul class="site-footer__col-list" role="list">
          <li>
            <a class="site-footer__col-link" href="/projets/">Projets</a>
          </li>
          <li><a
              class="site-footer__col-link" href="/files/plaquette-pxlc.pdf" target="_blank"
              rel="noopener noreferrer"
              aria-label="Télécharger la plaquette (PDF, 6 pages, nouvel onglet)">Télécharger la plaquette</a></li>
          <li>
            <a class="site-footer__col-link" href="/plaquette/">Lire la plaquette en ligne</a>
          </li>
          <li>
            <a class="site-footer__col-link" href="/a-propos/">À propos d’Andy Zébus</a>
          </li>
        </ul>
      </div>

      <div>
        <p class="site-footer__col-title">Contact</p>
        <ul class="site-footer__col-list site-footer__col-list--icons" role="list">
          <li>
            <a class="site-footer__col-link site-footer__col-link--icon" href="/contact/">
              <MessageSquare aria-hidden="true" class="site-footer__contact-icon" />
              Décrire votre projet en 2&nbsp;min
            </a>
          </li>
        </ul>
      </div>
    </div>

    <div class="site-footer__legal">
      <p>© 2015–{year} · PXLC · Réalisé par <a href="https://www.linkedin.com/in/azebus" target="_blank" rel="noopener noreferrer" aria-label="Profil LinkedIn d’Andy Zébus (nouvel onglet)">Andy Zébus</a></p>
      <ul class="site-footer__legal-links" role="list">
        <li>
          <a href="/mentions-legales/">Mentions légales</a>
        </li>
        <li>
          <a href="/mentions-legales/#rgpd">Confidentialité</a>
        </li>
        <li>
          <a href="/accessibilite/">Accessibilité</a>
        </li>
      </ul>
      <PxlcDuo onDark />
    </div>
  </div>
</footer>
