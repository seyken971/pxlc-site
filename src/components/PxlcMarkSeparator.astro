---
/**
 * Séparateur horizontal : deux filets encadrant la petite marque 18 px.
 * @usage Entre deux sections de contenu (accueil, pages légales).
 * @a11y Décoratif : bloc entier en aria-hidden.
 */
import PxlcMark from './PxlcMark.astro'
---

<div class="mark-separator" aria-hidden="true">
  <span class="mark-separator__line"></span>
  <PxlcMark size={18} decorative />
  <span class="mark-separator__line"></span>
</div>

<style>
  .mark-separator {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    padding: clamp(24px, 4vw, 40px) 0;
    max-width: 320px;
    margin: 0 auto;
  }

  .mark-separator__line {
    flex: 1;
    height: 1px;
    background: var(--line);
  }
</style>
