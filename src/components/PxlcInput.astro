---
/**
 * Champ de formulaire avec son libellé : input, ou textarea dès que rows
 * est fourni.
 * @usage Formulaire de la page contact.
 * @a11y Libellé visible relié par for/id ; champ requis marqué par
 * l'attribut natif required, l'astérisque visuel restant en aria-hidden.
 */
import type { HTMLAttributes } from 'astro/types'

interface Props {
  /** Identifiant du champ, relié au libellé. */
  id: string
  /** Libellé visible. */
  label: string
  /** Type d'input (text par défaut) ; ignoré en textarea. */
  type?: HTMLAttributes<'input'>['type']
  /** Exemple de saisie, jamais un substitut du libellé. */
  placeholder?: string
  /** Nombre de lignes : rend une textarea. */
  rows?: number
  /** Champ obligatoire (required natif, astérisque visuel). */
  required?: boolean
  /** Jeton autocomplete (name, email…) ; ignoré en textarea. */
  autocomplete?: string
}
const { id, label, type, placeholder, rows, required, autocomplete } = Astro.props
---

<div>
  <label for={id} class="form-label">{label}{required && <span class="form-label__req" aria-hidden="true">*</span>}</label>
  {rows
    ? (
        <textarea
          id={id}
          rows={rows}
          placeholder={placeholder}
          required={required}
          class="form-textarea"></textarea>
      )
    : (
        <input
          id={id}
          type={type ?? 'text'}
          placeholder={placeholder}
          required={required}
          autocomplete={autocomplete}
          class="form-input"
        />
      )}
</div>
