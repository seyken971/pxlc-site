---
import PxlcLockup from './PxlcLockup.astro'
import PxlcMark from './PxlcMark.astro'
import PxlcDuo from './PxlcDuo.astro'
import { NAV_ITEMS, isActive, navHref } from '../config/nav'
import { IDENTITY } from '../config/identity'

const pathname = Astro.url.pathname
---

<div
  id="mobile-menu"
  class="mobile-menu"
  inert
  role="dialog"
  aria-modal="true"
  aria-label="Menu de navigation"
>
  <!-- Decorative: PxlcMark watermark (bottom-right, 18 % opacity) -->
  <div class="mobile-menu__watermark">
    <PxlcMark size={400} decorative onDark />
  </div>

  <!-- Decorative: motif Duo (top-right, 40 % opacity) -->
  <div class="mobile-menu__strip">
    <PxlcDuo onDark />
  </div>

  <!-- Header row: lockup + close button -->
  <div class="mobile-menu__head">
    <PxlcLockup onDark />
    <button
      type="button"
      class="mobile-menu__close"
      aria-label="Fermer le menu"
    >
      <svg
        width="18"
        height="18"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
        aria-hidden="true"
      >
        <path d="M18 6L6 18M6 6l12 12"></path>
      </svg>
    </button>
  </div>

  <!-- Nav links — staggered entrance via --i CSS custom property -->
  <nav class="mobile-menu__nav" aria-label="Navigation mobile">
    {NAV_ITEMS.map((n, i) => (
      <a
        href={navHref(n.url)}
        class:list={['mobile-menu__link', { 'is-active': isActive(pathname, n.url) }]}
        aria-current={isActive(pathname, n.url) ? 'page' : undefined}
        style={`--i: ${i}`}
      >
        {n.label}
        <span class="mobile-menu__arrow" aria-hidden="true">→</span>
      </a>
    ))}
  </nav>

  <!-- Bottom bar: primary CTA + plaquette PDF secondary -->
  <div class="mobile-menu__bottom">
    <a
      href={IDENTITY.bookingUrl}
      target="_blank"
      rel="noopener noreferrer"
      class="btn btn--primary mobile-menu__cta-btn"
    >
      Prendre rendez-vous
    </a>
    <a
      href="/files/plaquette-pxlc.pdf"
      target="_blank"
      rel="noopener noreferrer"
      class="mobile-menu__plaquette"
      aria-label="Télécharger la plaquette (PDF, 6 pages, nouvel onglet)"
    >
      Télécharger la plaquette
    </a>
  </div>
</div>

<script>
  // Portage DOM du menu mobile : ouverture via le burger du header, fermeture
  // (✕, Échap, lien cliqué), verrou du scroll body, et piège de focus tant que
  // le dialog est ouvert — Tab / Maj+Tab bouclent, tout focus égaré revient
  // dedans. La fermeture au changement de route est devenue inutile en MPA.
  const menu = document.getElementById('mobile-menu')
  const burger = document.querySelector<HTMLButtonElement>('.burger')
  const closeBtn = menu?.querySelector<HTMLButtonElement>('.mobile-menu__close')

  const FOCUSABLE = 'a[href], button:not([disabled]), [tabindex]:not([tabindex="-1"])'

  const isOpen = () => menu?.classList.contains('is-open') ?? false

  const setOpen = (open: boolean) => {
    if (!menu || !burger) return
    menu.classList.toggle('is-open', open)
    if (open) menu.removeAttribute('inert')
    else menu.setAttribute('inert', '')
    burger.setAttribute('aria-expanded', String(open))
    burger.setAttribute('aria-label', open ? 'Fermer le menu' : 'Ouvrir le menu')
    document.body.style.overflow = open ? 'hidden' : ''
    if (open) closeBtn?.focus()
  }

  // Fermeture explicite (✕ ou Échap) : le focus revient sur le burger.
  const closeAndRestore = () => {
    setOpen(false)
    burger?.focus()
  }

  burger?.addEventListener('click', () => setOpen(!isOpen()))
  closeBtn?.addEventListener('click', closeAndRestore)
  menu?.querySelectorAll('a').forEach((a) => {
    a.addEventListener('click', () => setOpen(false))
  })

  document.addEventListener('keydown', (e) => {
    if (!isOpen() || !menu) return
    if (e.key === 'Escape') { closeAndRestore(); return }
    if (e.key !== 'Tab') return

    const nodes = Array.from(menu.querySelectorAll<HTMLElement>(FOCUSABLE))
    const first = nodes[0]
    const last = nodes[nodes.length - 1]
    if (!first || !last) return

    const active = document.activeElement
    if (!menu.contains(active)) {
      e.preventDefault()
      first.focus()
    }
    else if (e.shiftKey && active === first) {
      e.preventDefault()
      last.focus()
    }
    else if (!e.shiftKey && active === last) {
      e.preventDefault()
      first.focus()
    }
  })
</script>

<style>
  /* Le container global est flex-row — on bascule en colonne pour empiler
     le bouton primaire et le lien plaquette. */
  .mobile-menu__bottom {
    flex-direction: column;
    align-items: stretch;
  }
  .mobile-menu__plaquette {
    text-align: center;
    font-family: var(--font-label);
    font-size: 13px;
    font-weight: 600;
    letter-spacing: 0.04em;
    color: var(--pxlc-text-on-dark-soft);
    padding-block: var(--space-2-5);
    transition: color var(--dur-fast);
  }
  .mobile-menu__plaquette:hover { color: var(--pxlc-ivory); text-decoration: none; }
</style>
