---
/**
 * Le nom « pxlc » du logotype PXLC, seul : la version courte du logo
 * (Bricolage Grotesque ExtraBold vectorisé). Couleur --logo-ink : bleu
 * nuit en clair, blanc en sombre ou sur une surface color-scheme: dark.
 * Ne jamais le recolorer (la couleur appartient à « parents » et
 * « enfants »), le déformer, l'ombrer ni le pivoter (seul le filigrane
 * incliné à −8° l'est).
 * @usage Petits espaces où le logotype complet ferait moins de 160 px de
 * large (cartes, séparateur, en-tête de la plaquette) et filigrane.
 * Ailleurs, préférer PxlcLogotype.
 * @a11y role="img" et aria-label « pxlc » par défaut ; decorative le
 * passe en aria-hidden quand un texte voisin nomme déjà la marque.
 */
// Tracé : source unique src/lib/logo-geometry.ts, partagée avec la carte
// OG et le générateur des fichiers du logo (npm run logo).
import { LOGO_NAME } from '../lib/logo-geometry'

interface Props {
  /** Hauteur du mot, en px ; la largeur suit (≈ 2,1 fois la hauteur). */
  size?: number
  /** Masque le logo aux technologies d'assistance (aria-hidden). */
  decorative?: boolean
  /** Classes ajoutées au SVG (placement dans le parent). */
  class?: string
}
const { size = 36, decorative = false, class: className } = Astro.props
const width = Math.round(size * (LOGO_NAME.width / LOGO_NAME.height) * 10) / 10
---

<svg
  class:list={['mark-svg', className]}
  viewBox={`0 0 ${LOGO_NAME.width} ${LOGO_NAME.height}`}
  width={width}
  height={size}
  role={decorative ? undefined : 'img'}
  aria-label={decorative ? undefined : 'pxlc'}
  aria-hidden={decorative ? 'true' : undefined}
>
  <path fill="var(--logo-ink)" d={LOGO_NAME.d} />
</svg>
