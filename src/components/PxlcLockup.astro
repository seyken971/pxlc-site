---
/**
 * Le logotype PXLC complet en lien vers l'accueil. Sur une surface
 * toujours sombre (pied de page, menu mobile), color-scheme: dark donne
 * la version fond sombre : aucune prop à passer.
 * @usage En-tête, pied de page, menu mobile, page 404.
 * @a11y Un seul lien nommé « PXLC — accueil » ; le logotype interne est
 * decorative pour ne pas annoncer la marque deux fois.
 */
import PxlcLogotype from './PxlcLogotype.astro'

interface Props {
  /** Gabarit : hauteur du logotype 44, 56 ou 72 px. */
  size?: 'sm' | 'md' | 'lg'
  /** Destination du lien. */
  href?: string
  /** Classes ajoutées au lien (placement dans le parent). */
  class?: string
}
const { size = 'sm', href = '/', class: className } = Astro.props
const height = size === 'lg' ? 72 : size === 'md' ? 56 : 44
---

<a class:list={['lockup', className]} href={href} aria-label="PXLC — accueil">
  <PxlcLogotype size={height} decorative class="lockup__logo" />
</a>
