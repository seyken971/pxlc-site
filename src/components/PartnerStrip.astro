---
/**
 * Bandeau des partenaires de confiance, en liste de noms.
 * @usage Accueil, sous le hero.
 * @a11y Section nommée ; liste avec role="list" pour garder la sémantique
 * malgré list-style: none.
 */
interface Props {
  /** Noms des structures partenaires, affichés dans l'ordre. */
  partners?: string[]
}
const { partners = ['SESSAD Lékoklaya'] } = Astro.props
---

<section class="partners" aria-label="Partenaires et structures de confiance">
  <div class="container partners__inner">
    <span class="partners__label">Partenaires de confiance</span>
    <ul class="partners__list" role="list">
      {partners.map(p => <li class="partners__item">{p}</li>)}
    </ul>
  </div>
</section>

<style>
  .partners { border-top: 1px solid var(--line); border-bottom: 1px solid var(--line); padding: var(--space-4) 0; }
  .partners__inner { display: flex; flex-wrap: wrap; align-items: center; gap: var(--space-5); justify-content: space-between; }
  .partners__label { font-family: var(--font-label); font-size: var(--fs-label); letter-spacing: 0.22em; text-transform: uppercase; color: var(--ink-quiet); }
  .partners__list { display: flex; flex-wrap: wrap; gap: clamp(16px, 3vw, 48px); align-items: center; list-style: none; padding: 0; margin: 0; }
  .partners__item {
    display: flex; align-items: center; gap: var(--space-2);
    font-family: var(--font-display); font-weight: 500; font-size: var(--fs-body-sm);
    /* Pas d'opacité : --ink-quiet dilué passe sous le contraste AA. */
    color: var(--ink-quiet);
  }
  .partners__item::before { content: ""; width: 10px; height: 10px; background: var(--line); border-radius: 2px; }
</style>
