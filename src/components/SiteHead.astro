---
import { createHash } from 'node:crypto'
import { SITE } from '../config/site'

// Surface SEO d'une page — title, canonical, metas, OG/Twitter, JSON-LD —
// partagée par BaseLayout (pages du site) et PlaquetteLayout (page A4 sans
// chrome). Le script anti-flash et le thème restent du ressort des layouts :
// la plaquette épingle le mode clair, les autres pages suivent la préférence.
// La baseline SEO (docs/seo-baseline) verrouille tout ce qui est émis ici.

export interface Props {
  /** Titre de page sans suffixe — « %s · PXLC » appliqué ici. ≤ 53 caractères. */
  title: string
  /** Meta description. ≤ 120 caractères. */
  description: string
  /** og:description si différente de description (ex : accueil). */
  ogDescription?: string
  /** og:title si différent du titre complet — les articles retirent le
      suffixe « · PXLC » (og:site_name porte déjà la marque). */
  ogTitle?: string
  ogType?: 'website' | 'article'
  robots?: string
  /** URL absolue de l'image OG (1200×675, 16:9). */
  ogImage?: string
  /** Texte alternatif de l'image OG — la carte de marque par défaut. */
  ogImageAlt?: string
  /** Graphe schema.org complet de la page (nœuds du @graph). */
  schemaGraph?: object[]
  /** `light dark` par défaut ; `light` pour une page au thème épinglé. */
  colorScheme?: 'light dark' | 'light'
}

const {
  title,
  description,
  ogDescription = description,
  ogType = 'website',
  robots = 'index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1',
  // La query versionne la carte pour les caches sociaux (LinkedIn garde une image
  // environ 7 jours sous une URL donnée) : l'incrémenter à chaque changement visuel.
  ogImage = `${SITE.url}/og/site.png?v=1200x675`,
  ogImageAlt = 'Logo PXLC — Médiation numérique · Guadeloupe',
  schemaGraph,
  colorScheme = 'light dark',
} = Astro.props

const fullTitle = `${title}${SITE.titleSuffix}`
const { ogTitle = fullTitle } = Astro.props
const canonical = new URL(Astro.url.pathname, SITE.url).href

// La CSP est émise par Astro (security.csp dans astro.config.mjs), qui hache
// lui-même les scripts et styles qu'il traite. Le JSON-LD est un script inline
// propre à chaque page : on le sérialise une fois, on déclare son hash, puis on
// rend cette même chaîne — hash et contenu servi restent identiques.
const jsonLd = schemaGraph
  ? JSON.stringify({ '@context': 'https://schema.org', '@graph': schemaGraph })
  : null
if (jsonLd) {
  Astro.csp?.insertScriptHash(`sha256-${createHash('sha256').update(jsonLd, 'utf8').digest('base64')}`)
}
---

<title>{fullTitle}</title>
<!-- Canonical omis sur une page noindex : les deux signaux se contredisent
     (recommandation Google, reprise par le guide SEO Astro de Joost de Valk). -->
{!robots.includes('noindex') && <link rel="canonical" href={canonical} />}
<meta name="description" content={description} />
<meta name="robots" content={robots} />
<meta name="author" content={SITE.author} />
<meta name="color-scheme" content={colorScheme} />
<meta name="theme-color" content="#082B36" media="(prefers-color-scheme: dark)" />
<meta name="theme-color" content="#F4F1EA" media="(prefers-color-scheme: light)" />
<meta property="og:title" content={ogTitle} />
<meta property="og:description" content={ogDescription} />
<meta property="og:url" content={canonical} />
<meta property="og:type" content={ogType} />
<meta property="og:site_name" content={SITE.name} />
<meta property="og:locale" content={SITE.locale} />
<meta property="og:image" content={ogImage} />
<meta property="og:image:alt" content={ogImageAlt} />
<meta property="og:image:type" content="image/png" />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="675" />
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:site" content={SITE.twitter} />
<meta name="twitter:creator" content={SITE.twitter} />
<meta name="twitter:image" content={ogImage} />
<meta name="twitter:image:src" content={ogImage} />
<meta name="twitter:image:width" content="1200" />
<meta name="twitter:image:height" content="675" />
<!-- Signal secondaire : les moteurs s'appuient sur la directive Sitemap de
     robots.txt, mais la doc de @astrojs/sitemap recommande aussi ce lien. -->
<link rel="sitemap" href="/sitemap-index.xml" />
<!-- Préchargement des deux fontes du premier écran (sous-ensemble latin) :
     évite le swap tardif des titres et du corps, cf. guide SEO Astro (Core
     Web Vitals). Les sous-ensembles latin-ext restent à la demande. -->
<link rel="preload" href="/fonts/plus-jakarta-sans-latin.woff2" as="font" type="font/woff2" crossorigin />
<link rel="preload" href="/fonts/lora-latin.woff2" as="font" type="font/woff2" crossorigin />
<link rel="shortcut icon" href="/favicon.ico" />
<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
<link rel="manifest" href="/site.webmanifest" />
{jsonLd && <script type="application/ld+json" set:html={jsonLd} />}
