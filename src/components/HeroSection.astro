---
/**
 * Hero de page : eyebrow, titre h1, chapô, un CTA primaire et un CTA
 * secondaire, photo et pastille facultatives, filigrane du logo.
 * @usage Une fois par page, en tête ; porte l'unique h1.
 * @a11y Section reliée à son h1 ; CTA externes suffixés « (nouvel
 * onglet) » dans leur aria-label ; filigrane en aria-hidden ; photo
 * décrite par photoAlt.
 */
import type { ImageMetadata } from 'astro'
import { Image } from 'astro:assets'
import PxlcMark from './PxlcMark.astro'
import PxlcDuo from './PxlcDuo.astro'

interface Cta { label: string, href: string, external?: boolean }
/** Lien texte discret à côté du CTA secondaire (ex. version web de la plaquette PDF). */
interface AltLink { label: string, href: string, ariaLabel?: string }
interface Pill { eyebrow: string, text: string }

interface Props {
  /** Surtitre au-dessus du h1. */
  eyebrow?: string
  /** Titre de la page, rendu en h1. */
  title: string
  /** Ajoute un point final stylé (coral-dot) après le titre. */
  titleDot?: boolean
  /** Chapô sous le titre. */
  lead?: string
  /** Le CTA primaire de la section (un seul). */
  ctaPrimary?: Cta | null
  /** CTA secondaire, en bouton ghost. */
  ctaSecondary?: Cta | null
  /** Lien texte discret à côté du CTA secondaire. */
  ctaSecondaryAlt?: AltLink | null
  /** Mention courte sous les CTA. */
  hint?: string | null
  /** Photo importée depuis src/assets (astro:assets génère les variantes webp). */
  photo?: ImageMetadata | null
  /** Texte alternatif de la photo. */
  photoAlt?: string
  /** Pastille posée sur la photo : surtitre et texte. */
  pill?: Pill | null
  /** Affiche le logo en filigrane incliné en fond. */
  showBgMark?: boolean
}
const {
  eyebrow = 'PXLC · Guadeloupe',
  title,
  titleDot = false,
  lead = '',
  ctaPrimary = null,
  ctaSecondary = null,
  ctaSecondaryAlt = null,
  hint = null,
  photo = null,
  photoAlt = '',
  pill = null,
  showBgMark = true,
} = Astro.props
---

<section class="hero" aria-labelledby="hero-title">
  <div class="hero__strip"><PxlcDuo /></div>
  {showBgMark && (
    <div class="hero__bg-mark" aria-hidden="true">
      <PxlcMark size={420} decorative />
    </div>
  )}
  <div class="container">
    <div class="hero__inner">
      <div>
        <span class="eyebrow">{eyebrow}</span>
        <h1
          id="hero-title"
          class:list={['hero__title', { 'hero__title--dot': titleDot }]}
        >{title}</h1>
        {lead && <p class="hero__lead">{lead}</p>}
        <div class="hero__actions">
          {ctaPrimary && !ctaPrimary.external && (
            <a href={ctaPrimary.href} class="btn btn--primary btn--lg">{ctaPrimary.label}</a>
          )}
          {ctaPrimary && ctaPrimary.external && (
            <a
              href={ctaPrimary.href}
              target="_blank"
              rel="noopener noreferrer"
              class="btn btn--primary btn--lg"
              aria-label={`${ctaPrimary.label} (nouvel onglet)`}
            >{ctaPrimary.label}</a>
          )}

          {ctaSecondary && !ctaSecondary.external && (
            <a href={ctaSecondary.href} class="btn btn--ghost btn--lg btn--no-arrow">{ctaSecondary.label}</a>
          )}
          {ctaSecondary && ctaSecondary.external && (
            <a
              href={ctaSecondary.href}
              target="_blank"
              rel="noopener noreferrer"
              class="btn btn--ghost btn--lg btn--no-arrow"
              aria-label={`${ctaSecondary.label} (nouvel onglet)`}
            >{ctaSecondary.label}</a>
          )}

          {ctaSecondaryAlt && (
            <a href={ctaSecondaryAlt.href} class="hero__alt" aria-label={ctaSecondaryAlt.ariaLabel}>{ctaSecondaryAlt.label}</a>
          )}

          {hint && <span class="hero__hint">{hint}</span>}
        </div>
      </div>

      {photo && (
        <div class="hero__media">
          <div class="hero__media-img">
            <Image
              src={photo}
              alt={photoAlt}
              widths={[740, 1480]}
              sizes="(max-width: 767px) 100vw, 740px"
              format="webp"
              loading="eager"
              fetchpriority="high"
            />
          </div>
          {pill && (
            <div class="hero__pill">
              <div class="hero__pill-eyebrow">{pill.eyebrow}</div>
              <div class="hero__pill-text">{pill.text}</div>
            </div>
          )}
        </div>
      )}
    </div>
  </div>
</section>

<style>
  /* Coupures de ligne équilibrées par le navigateur (titre court). */
  .hero__title { text-wrap: balance; }
  /* Coral-dot period rendered via CSS — immune to source-whitespace sensitivity. */
  .hero__title--dot::after { content: '.'; color: var(--pxlc-coral); }
</style>
