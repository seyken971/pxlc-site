---
/**
 * Section de citation institutionnelle : source, extrait entre guillemets
 * français, attribution.
 * @usage Citation sourcée depuis docs/references/, jamais reformulée.
 * @a11y Section nommée « Référence institutionnelle » ; figure,
 * blockquote et figcaption ; guillemets décoratifs en aria-hidden.
 */
interface Props {
  /** Document cité, affiché au-dessus de l'extrait. */
  source: string
  /** Extrait exact, sans guillemets (ajoutés par le composant). */
  quote: string
  /** Auteur, date et section de la citation. */
  attribution: string
  /** Fond doux (.section--soft). */
  soft?: boolean
}
const { source, quote, attribution, soft = true } = Astro.props
---

<section class:list={['section', { 'section--soft': soft }]} aria-label="Référence institutionnelle">
  <div class="container">
    <figure class="citation">
      <div class="citation__source">{source}</div>
      <blockquote class="citation__quote">
        <span class="quotemark" aria-hidden="true">«&nbsp;</span>{quote}<span class="quotemark" aria-hidden="true">&nbsp;»</span>
      </blockquote>
      <figcaption class="citation__attr">{attribution}</figcaption>
    </figure>
  </div>
</section>

<style>
  .citation { text-align: center; max-width: 880px; margin: 0 auto; }
  .citation__source { font-family: var(--font-label); font-size: 11px; letter-spacing: 0.22em; text-transform: uppercase; color: var(--parent); margin-bottom: var(--space-4); }
  .citation__quote {
    margin: 0 0 var(--space-3); font-family: var(--font-display); font-weight: 500;
    font-size: clamp(22px, 3vw, 30px); line-height: 1.25; letter-spacing: -0.015em; color: var(--ink);
  }
  .citation__quote .quotemark { color: var(--pxlc-coral); }
  .citation__attr { font-family: var(--font-body); font-size: 14px; letter-spacing: 0.04em; color: var(--ink-quiet); }
</style>
