---
import { Image } from 'astro:assets'
import PlaquetteLayout from '../layouts/PlaquetteLayout.astro'
import PlaquettePage from '../components/PlaquettePage.astro'
import PxlcMark from '../components/PxlcMark.astro'
import { IDENTITY, RCS_MENTION } from '../config/identity'
import { SITE } from '../config/site'
import { PROJECTS } from '../config/projects'
import { PROJECT_THEMES } from '../config/project-themes'
import { pageGraph } from '../lib/schema'
import { breadcrumbItems } from '../lib/breadcrumb'
import andyPortrait from '../assets/photos/andy-portrait.jpg'

// Plaquette de présentation, 6 feuilles A4. Cette page EST la source du PDF
// public/files/plaquette-pxlc.pdf : scripts/export-plaquette.mjs l'imprime
// depuis dist/ (npm run plaquette). Toute modification ici se relance et se
// committe avec le PDF. Identité, contact, thèmes et données du projet
// viennent de src/config (jamais retapés).
const VERSION = 'v6'
const lekoklaya = PROJECTS[0]
const TOTAL = '06'
const PDF_HREF = '/files/plaquette-pxlc.pdf'
const BOOKING = IDENTITY.bookingUrlDisplay

const website = SITE.url.replace(/^https?:\/\//, '').replace(/\/$/, '')
const nbsp = (s: string) => s.replace(/ /g, ' ')
/** +590690717618 → +590 690 71 76 18 (forme de la page contact). */
const phone = IDENTITY.telephone.replace(/^(\+590)(\d{3})(\d{2})(\d{2})(\d{2})$/, '$1 $2 $3 $4 $5')
const address = `${IDENTITY.address.street}, ${IDENTITY.address.postalCode} ${IDENTITY.address.locality}`

const seo = {
  title: 'Plaquette de présentation',
  description: 'La plaquette PXLC en 6 pages : mission, méthode en trois temps et projet « Jouons Ensemble ! » au SESSAD Lékoklaya.',
  ogDescription: SITE.description,
}

const schemaGraph = pageGraph({
  path: '/plaquette/',
  name: 'Plaquette de présentation de PXLC',
  description: seo.description,
  crumbs: breadcrumbItems('/plaquette/', 'Plaquette'),
})
---

<PlaquetteLayout {...seo} schemaGraph={schemaGraph}>
  <nav class="pq-toolbar pq-screen-only" aria-label="Navigation de la plaquette">
    <a class="btn btn--ghost btn--no-arrow" href="/">Retour au site</a>
    <a
      class="btn btn--ghost btn--no-arrow" href={PDF_HREF} target="_blank" rel="noopener noreferrer"
      aria-label="Télécharger le PDF (plaquette, 6 pages, nouvel onglet)">Télécharger le PDF</a>
  </nav>

  <div class="pq-pages">

    <!-- ═══════════════════════ 01 · Couverture ═══════════════════════ -->
    <PlaquettePage num="01" total={TOTAL} cover version={VERSION} website={website} screenLabel="01 · Couverture">
      <div class="pq-cover__bg-mark" aria-hidden="true">
        <PxlcMark size={100} decorative onDark />
      </div>
      <div class="pq-cover__inner">
        <div class="pq-cover__brand">
          <PxlcMark size={26} decorative onDark />
          <span>PXLC</span>
        </div>

        <div class="pq-cover__eyebrow">Écrans en famille · Guadeloupe</div>
        <h1 class="pq-cover__title">Médiation numérique<span class="coral-dot" aria-hidden="true">.</span></h1>
        <p class="pq-cover__lead">PXLC accompagne les familles <strong>autour des écrans</strong>.</p>

        <div class="pq-cover__meta">
          <div>Cadre<strong>HCSP&nbsp;2019-2020 · HAS&nbsp;2020</strong></div>
          <div>Format<strong>Ateliers parent-enfant</strong></div>
          <div>Public<strong>Médiathèques · centres sociaux · écoles · SESSAD · IME</strong></div>
        </div>
      </div>
    </PlaquettePage>

    <!-- ═══════════════════════ 02 · Mission ═══════════════════════ -->
    <PlaquettePage num="02" total={TOTAL} label="01 · La mission" version={VERSION} website={website} screenLabel="02 · Mission">
      <span class="eyebrow">01 · La mission</span>
      <h2>Le numérique, une histoire de lien<span class="coral-dot" aria-hidden="true">.</span></h2>
      <p class="pq-lead">PXLC accompagne les familles <strong>autour des écrans</strong>. J'interviens dans les structures de Guadeloupe qui accueillent déjà des familles&nbsp;: le lieu apporte le public, j'apporte l'atelier et le cadre.</p>

      <div class="pq-grid-3 pq-mb-8">
        <div class="pq-card">
          <span class="eyebrow">Le constat</span>
          <p>Votre équipe accompagne des familles où les écrans — jeux vidéo en tête — reviennent en entretien comme point de friction récurrent. Sans que vous ayez toujours les ressources spécifiques pour y répondre dans le cadre de votre accompagnement.</p>
        </div>
        <div class="pq-card">
          <span class="eyebrow">Le parti-pris</span>
          <p>Le cadre HCSP&nbsp;2019-2020 · HAS&nbsp;2020 invite à <strong>soutenir la fonction parentale</strong> dans la médiation des écrans plutôt qu'à les interdire. Je traduis ce cadre en ateliers directement intégrables dans votre projet de service ou d'établissement.</p>
        </div>
        <div class="pq-card">
          <span class="eyebrow">Pour qui</span>
          <p>Les structures qui accueillent déjà des familles — médiathèques, centres sociaux, écoles, CCAS, SESSAD, IME — et qui cherchent un <strong>intervenant spécialisé</strong>, pas un module numérique générique, pour les familles où le jeu vidéo est source de tension.</p>
        </div>
      </div>

      <div class="pq-quote">
        <span class="pq-quote__mark" aria-hidden="true">«&nbsp;</span>Mon travail, ce n'est pas de juger l'usage des écrans. C'est de créer un espace de rencontre — autour du jeu vidéo, des réseaux, du temps d'écran — entre un enfant et son parent, entre une famille et votre équipe.<span class="pq-quote__mark" aria-hidden="true">&nbsp;»</span>
        <span class="pq-quote__src">Andy Zébus · médiateur numérique</span>
      </div>

      <div class="pq-card pq-card--dark">
        <span class="eyebrow">Ma promesse aux structures</span>
        <p>Je m'adapte à votre cadre de confidentialité, à vos bilans et à vos objectifs de service ou de soin. Je viens en appui de l'équipe — pas à sa place. Je reviens autant de fois que nécessaire, sur la durée du projet. <strong>Premier échange de 20&nbsp;min gratuit, sans engagement.</strong></p>
        <p class="pq-card__contact">{BOOKING} ·{IDENTITY.email} · {nbsp(phone)}</p>
      </div>
    </PlaquettePage>

    <!-- ═══════════════════════ 03 · Qui je suis ═══════════════════════ -->
    <PlaquettePage num="03" total={TOTAL} label="02 · Qui je suis" version={VERSION} website={website} screenLabel="03 · Qui je suis">
      <span class="eyebrow">02 · Qui je suis</span>
      <h2>Andy Zébus · trois casquettes<span class="coral-dot" aria-hidden="true">.</span></h2>

      <div class="pq-bio">
        <p class="pq-bio__text">Né en Guadeloupe, formé à la médiation interculturelle et au numérique, j'ai passé plus de 6&nbsp;ans à structurer la scène esport locale avant de créer <strong>PXLC</strong>. Ce qui me motive&nbsp;: les familles qui traversent en silence des conflits autour des écrans — et les équipes qui veulent des outils concrets pour les accompagner.</p>
        <div class="pq-photo pq-bio__photo">
          <Image
            src={andyPortrait}
            alt="Portrait d'Andy Zébus, créateur de PXLC"
            width={520}
            loading="eager"
            class="pq-photo__img pq-photo__img--portrait"
          />
        </div>
      </div>

      <div class="pq-grid-3 pq-casquettes">
        <div class="pq-card">
          <span class="kicker">Casquette 01</span>
          <h3 class="pq-casquette__title">Organisateur esport</h3>
          <p class="pq-casquette__desc">Plus de 6&nbsp;ans sur la scène esport guadeloupéenne — Destreland Gaming Cup, tournois, partenariats. Je parle aux enfants dans leur registre culturel. C'est ce qui fait que les ateliers ne ressemblent pas à une leçon.</p>
        </div>
        <div class="pq-card">
          <span class="kicker">Casquette 02</span>
          <h3 class="pq-casquette__title">Médiateur formé</h3>
          <p class="pq-casquette__desc">Formateur principal en médiation numérique chez Simplon Outre-Mer (2021–2022). Je travaille dans le cadre HCSP&nbsp;2019-2020 · HAS&nbsp;2020 — ce qui facilite directement l'articulation avec votre projet de service ou de soin et vos bilans.</p>
        </div>
        <div class="pq-card">
          <span class="kicker">Casquette 03</span>
          <h3 class="pq-casquette__title">Conseil institutionnel</h3>
          <p class="pq-casquette__desc">Affaires européennes et numérique THD à la Région Guadeloupe. Je maîtrise le vocabulaire des commissions et des rapports d'activité — utile pour justifier et documenter le dispositif.</p>
        </div>
      </div>

      <div class="pq-card pq-card--ivory">
        <span class="eyebrow">Ce que ça change pour vous</span>
        <p>Un seul interlocuteur qui fait le pont entre 3 mondes qui se parlent rarement&nbsp;: la culture joueur, le cadre du soin, le langage institutionnel. Côté enfant&nbsp;: un adulte qui joue sans juger. Côté parent&nbsp;: quelqu'un qui traduit. Côté équipe&nbsp;: un partenaire qui rend compte.</p>
      </div>
    </PlaquettePage>

    <!-- ═══════════════════════ 04 · La méthode ═══════════════════════ -->
    <PlaquettePage num="04" total={TOTAL} label="03 · La méthode" version={VERSION} website={website} screenLabel="04 · La méthode">
      <span class="eyebrow">03 · La méthode</span>
      <h2 class="pq-methode__title">Ma méthode en trois temps<span class="coral-dot" aria-hidden="true">.</span></h2>
      <p class="pq-lead pq-methode__lead">Une démarche en trois temps, pensée pour s'intégrer dans le projet d'un lieu qui accueille déjà des familles. Pas de discours moral, pas d'écran diabolisé — un cadre que votre équipe peut s'approprier.</p>

      <div class="pq-step">
        <div class="pq-step__num">01</div>
        <div>
          <div class="pq-step__phase">Diagnostic <span class="pq-step__duration">usages réels de la famille</span></div>
          <h3 class="pq-step__title">Faire le point</h3>
          <p class="pq-step__desc">Je pars des usages réels de la famille — à quoi l'enfant joue, ce que l'écran représente. Observer avant de cadrer&nbsp;: la prise de conscience est déjà un levier.</p>
          <span class="pq-step__deliv">Profil ludique de l'enfant, attentes des parents</span>
        </div>
      </div>

      <div class="pq-step">
        <div class="pq-step__num">02</div>
        <div>
          <div class="pq-step__phase">Stratégie <span class="pq-step__duration">ateliers parent-enfant</span></div>
          <h3 class="pq-step__title">Choisir une stratégie</h3>
          <p class="pq-step__desc">La famille co-construit ses repères d'usage. L'enfant participe au choix des règles, ce qui désamorce les conflits plutôt que de les déplacer. Chaque atelier articule un temps de jeu partagé (30 à 45&nbsp;min) et un temps d'échange (45&nbsp;min à 1&nbsp;h).</p>
          <span class="pq-step__deliv">Repères d'usage co-construits, observation des interactions</span>
        </div>
      </div>

      <div class="pq-step">
        <div class="pq-step__num">03</div>
        <div>
          <div class="pq-step__phase">Suivi <span class="pq-step__duration">restitution à l'équipe</span></div>
          <h3 class="pq-step__title">Dialogue continu</h3>
          <p class="pq-step__desc">Le cadre devient une clé d'explication impartiale&nbsp;: il ouvre la discussion parent-enfant au lieu de la fermer, et tient dans la durée. Un bilan écrit est remis à l'équipe et discuté avec elle.</p>
          <span class="pq-step__deliv">Bilan écrit, réutilisable dans vos rapports d'activité</span>
        </div>
      </div>

      <span class="eyebrow pq-frameworks__eyebrow">Le cadre de référence</span>
      <div class="pq-frameworks">
        <div class="pq-framework">
          <span class="pq-framework__pill">HCSP · 2019</span>
          <h4>Effets de l'exposition aux écrans</h4>
          <p>L'accompagnement parental actif, facteur clé pour limiter les effets négatifs.</p>
        </div>
        <div class="pq-framework">
          <span class="pq-framework__pill">HCSP · 2020</span>
          <h4>De l'usage excessif à la dépendance</h4>
          <p>Des repères pour prévenir le basculement vers un usage problématique des écrans.</p>
        </div>
        <div class="pq-framework">
          <span class="pq-framework__pill">HAS · 2020</span>
          <h4>Soutien à la parentalité</h4>
          <p>Cité avec les avis du HCSP dans chaque bilan remis à l'équipe.</p>
        </div>
      </div>
    </PlaquettePage>

    <!-- ═══════════════════════ 05 · Le déroulé ═══════════════════════ -->
    <PlaquettePage num="05" total={TOTAL} label="04 · Le déroulé" version={VERSION} website={website} screenLabel="05 · Le déroulé">
      <span class="eyebrow">04 · Le déroulé</span>
      <h2 class="pq-deroule__title">Parent-Écran-Enfant, du diagnostic au bilan<span class="coral-dot" aria-hidden="true">.</span></h2>
      <p class="pq-deroule__intro">Un cycle d'ateliers parent-enfant conduit avec l'équipe de la structure, du diagnostic familial au bilan écrit. Le jeu vidéo est le support de médiation, jamais le problème à résoudre.</p>

      <div class="pq-etapes">
        <div class="pq-etape">
          <span class="pq-etape__temps">Temps 1 · Diagnostic</span>
          <h3 class="pq-etape__title">Préparation</h3>
          <p>Entretiens familiaux avec l'équipe&nbsp;: profil ludique de chaque enfant, usages et attentes des parents, constitution des binômes parent-enfant.</p>
        </div>
        <div class="pq-etape">
          <span class="pq-etape__temps">Temps 2 · Stratégie</span>
          <h3 class="pq-etape__title">Ateliers thématiques parent-enfant</h3>
          <p>Un temps de jeu partagé puis un temps d'échange. Je choisis les jeux selon les objectifs de l'équipe, j'explique les mécaniques aux parents, j'accompagne en situation de jeu.</p>
        </div>
        <div class="pq-etape">
          <span class="pq-etape__temps">Temps 2 · Stratégie</span>
          <h3 class="pq-etape__title">Groupe de parole familiale</h3>
          <p>Régulation, repères d'usage, posture parentale&nbsp;: l'accompagnement parental que le cadre HCSP désigne comme le facteur clé.</p>
        </div>
        <div class="pq-etape">
          <span class="pq-etape__temps">Temps 3 · Suivi</span>
          <h3 class="pq-etape__title">Bilan</h3>
          <p>Synthèse des acquis parent et enfant, pistes de continuité à la maison, transmission écrite à l'équipe.</p>
        </div>
      </div>

      <span class="eyebrow pq-themes__eyebrow">Trois thèmes d'atelier</span>
      <div class="pq-themes">
        {PROJECT_THEMES.map(t => (
          <div class="pq-framework">
            <span class="pq-framework__pill">{t.title}</span>
            <p>{t.short}</p>
          </div>
        ))}
      </div>

      <div class="pq-indicateurs">
        <span class="kicker pq-indicateurs__label">Indicateurs suivis</span>
        <p>Questionnaires de satisfaction · grilles d'observation des compétences · diminution rapportée des conflits liés aux écrans · assiduité aux ateliers.</p>
      </div>

      <div class="pq-card pq-card--ivory pq-cas">
        <span class="eyebrow">Mis en œuvre au {lekoklaya.place} · {lekoklaya.year}</span>
        <p class="pq-cas__intro">Le programme s'y appelle «&nbsp;{lekoklaya.localName}&nbsp;». Bilan en cours&nbsp;: les résultats seront publiés quand l'équipe les aura validés.</p>
        <dl class="pq-cas__facts">
          <div><dt>Porteur</dt><dd>{lekoklaya.owner}</dd></div>
          <div><dt>Public</dt><dd>{lekoklaya.audience}</dd></div>
          <div><dt>Équipe</dt><dd>{lekoklaya.team}</dd></div>
        </dl>
      </div>
    </PlaquettePage>

    <!-- ═══════════════════════ 06 · Consentement ═══════════════════════ -->
    <PlaquettePage num="06" total={TOTAL} label="05 · Annexe" version={VERSION} website={website} screenLabel="06 · Consentement">
      <span class="eyebrow">05 · Annexe</span>
      <h2>Consentement parental<span class="coral-dot" aria-hidden="true">.</span></h2>

      <div class="pq-consent">
        <p class="pq-consent__intro">Dans le cadre du dispositif de médiation numérique «&nbsp;Jouons Ensemble&nbsp;!&nbsp;», je
          soussigné(e), responsable légal de l'enfant, déclare avoir été informé(e) des objectifs, du déroulé et du
          cadre du projet, et autorise&nbsp;:</p>

        <div class="pq-consent__checks">
          <div class="pq-consent__check">
            <div class="pq-consent__box" aria-hidden="true"></div>
            <p><strong>La participation de mon enfant aux ateliers.</strong>Participation libre aux ateliers
              parent-enfant, au groupe de parole et au bilan, dans le cadre de l'accompagnement de la structure.</p>
          </div>
          <div class="pq-consent__check">
            <div class="pq-consent__box" aria-hidden="true"></div>
            <p><strong>Le recueil d'observations à visée éducative.</strong>Utilisation des observations recueillies
              pendant les ateliers, de façon anonymisée, aux seules fins du suivi et du bilan transmis à l'équipe
              pluridisciplinaire.</p>
          </div>
          <div class="pq-consent__check">
            <div class="pq-consent__box" aria-hidden="true"></div>
            <p><strong>La captation photo / vidéo (facultatif).</strong>Prise de photographies ou de courtes vidéos
              pendant les ateliers, à usage interne de bilan. <em>Toute diffusion externe fera l'objet d'une
                autorisation distincte.</em></p>
          </div>
        </div>

        <h3 class="pq-consent__h3">Mes droits</h3>
        <p>Ce consentement est libre et peut être retiré à tout moment, sans justification ni conséquence sur
          l'accompagnement de mon enfant par la structure. Conformément au RGPD, je dispose d'un droit d'accès, de
          rectification et de suppression des données concernant mon enfant, en m'adressant à la structure ou à PXLC.</p>

        <div class="pq-consent__fields">
          <div class="pq-field">
            <span class="pq-field__label">Nom de l'enfant</span>
            <span class="pq-field__line"></span>
          </div>
          <div class="pq-field">
            <span class="pq-field__label">Date de naissance</span>
            <span class="pq-field__line"></span>
          </div>
          <div class="pq-field">
            <span class="pq-field__label">Responsable légal</span>
            <span class="pq-field__line"></span>
          </div>
          <div class="pq-field">
            <span class="pq-field__label">Lien avec l'enfant</span>
            <span class="pq-field__line"></span>
          </div>
        </div>

        <div class="pq-consent__sigs">
          <div class="pq-consent__sig">
            Le responsable légal
            <small>Fait à&nbsp;.................................... le&nbsp;....... / ....... / ...........</small>
            <span class="pq-consent__sig-line" aria-hidden="true"></span>
          </div>
          <div class="pq-consent__sig">
            La structure / PXLC
            <small>Nom &amp; qualité du référent</small>
            <span class="pq-consent__sig-line" aria-hidden="true"></span>
          </div>
        </div>

        <p class="pq-legal-note">{SITE.name} · {IDENTITY.legalName} · SIRET&nbsp;{nbsp(IDENTITY.siret)} · RCS&nbsp;{nbsp(RCS_MENTION)} · APE&nbsp;{IDENTITY.ape} · {address} · {IDENTITY.email} · {nbsp(phone)} · {website} — Données conservées le temps de la mission puis archivées
          conformément aux recommandations CNIL. Aucun transfert hors UE, aucun sous-traitant.</p>
      </div>
    </PlaquettePage>

  </div>
</PlaquetteLayout>

<style>
  /* ── Toolbar écran (masquée à l'impression par PlaquetteLayout) ── */
  .pq-toolbar {
    display: flex;
    justify-content: center;
    gap: var(--space-3);
    padding: var(--space-4) var(--container-pad) 0;
  }
  .pq-toolbar .btn { color: var(--pxlc-ivory); border-color: var(--pxlc-text-quiet-dark); }
  .pq-toolbar .btn:hover { color: var(--pxlc-ivory); border-color: var(--pxlc-ivory); }

  /* ── Utilitaires de feuille ─────────────────────────────── */
  .pq-mb-8 { margin-bottom: 8mm; }
  .pq-lead {
    font-family: var(--font-body);
    font-size: 13pt;
    line-height: 1.5;
    color: var(--ink-muted);
    margin-bottom: 8mm;
    max-width: 165mm;
  }
  .pq-lead strong { color: var(--ink); }
  .pq-grid-3 { display: grid; grid-template-columns: 1fr 1fr 1fr; gap: 5mm; }

  /* ── Couverture ────────────────────────────────────────── */
  .pq-cover__inner {
    height: 100%;
    display: flex;
    flex-direction: column;
    padding: 24mm 22mm 18mm 22mm;
    position: relative;
    z-index: 1;
  }
  /* Filigrane de la marque : −8°, 18 % sur fond sombre (design system PXLC 2026). */
  .pq-cover__bg-mark {
    position: absolute;
    width: 132mm; height: 132mm;
    right: -32mm; bottom: -30mm;
    opacity: 0.18;
    transform: rotate(-8deg);
    pointer-events: none;
  }
  .pq-cover__bg-mark :global(svg) { width: 100%; height: 100%; display: block; }
  .pq-cover__brand {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    font-family: var(--font-display);
    font-weight: 800;
    font-size: 17pt;
    color: var(--pxlc-ivory);
    letter-spacing: -0.035em;
    margin-bottom: 26mm;
  }
  .pq-cover__eyebrow {
    font-family: var(--font-label);
    font-size: 9pt;
    font-weight: 600;
    letter-spacing: 0.28em;
    text-transform: uppercase;
    color: var(--cyan);
    margin-bottom: 12mm;
  }
  .pq-cover__title {
    font-family: var(--font-display);
    font-size: 46pt;
    font-weight: 600;
    line-height: 1.02;
    letter-spacing: -0.035em;
    color: var(--pxlc-ivory);
    margin-bottom: 9mm;
    max-width: 168mm;
  }
  .pq-cover__lead {
    font-family: var(--font-body);
    font-size: 13pt;
    line-height: 1.5;
    color: var(--pxlc-text-on-dark-soft);
    max-width: 150mm;
    margin-bottom: auto;
  }
  .pq-cover__lead strong { color: var(--pxlc-ivory); font-weight: 600; }
  .pq-cover__meta {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 6mm;
    margin-top: 20mm;
    padding-top: 8mm;
    border-top: 1px solid var(--pxlc-border-dark-2);
    font-family: var(--font-label);
    font-size: 8pt;
    color: var(--pxlc-text-on-dark-soft);
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }
  .pq-cover__meta strong {
    color: var(--pxlc-ivory);
    display: block;
    font-weight: 600;
    margin-top: 2mm;
    letter-spacing: 0.1em;
  }

  /* ── Cartes ────────────────────────────────────────────── */
  .pq-card {
    background: var(--pxlc-white);
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
    padding: 6mm;
  }
  .pq-card p { margin: 3mm 0 0 0; font-size: 10pt; line-height: 1.5; }
  .pq-card .eyebrow { margin-bottom: 0; }
