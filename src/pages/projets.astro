---
import BaseLayout from '../layouts/BaseLayout.astro'
import SiteBreadcrumb from '../components/SiteBreadcrumb.astro'
import PxlcMark from '../components/PxlcMark.astro'
import PxlcDuo from '../components/PxlcDuo.astro'
import { PROJECTS } from '../config/projects'
import { PROJECT_THEMES as themes } from '../config/project-themes'
import { ID, pageGraph } from '../lib/schema'
import { breadcrumbItems } from '../lib/breadcrumb'
import { IDENTITY } from '../config/identity'

// FAQ — mise en oeuvre d'un projet, plus catalogue d'offre. Double emploi :
// source du rich result FAQPage (nœuds Question du @graph).
const faqs = [
  {
    id: 'demarrage',
    q: 'Comment démarre un projet ?',
    a: 'Par un premier échange de 20 min pour cadrer le périmètre, puis une rencontre avec l’équipe. Le point qui conditionne tout : qui, dans la structure, porte le projet au quotidien — au SESSAD Lékoklaya, c’est le psychologue. Le calendrier se cale ensuite sur le rythme du lieu, pas l’inverse.',
  },
  {
    id: 'roles',
    q: 'Qui fait quoi dans l’équipe ?',
    a: 'Le projet est porté par la structure — au SESSAD Lékoklaya, par le psychologue. J’interviens comme médiateur numérique aux côtés de l’équipe pluridisciplinaire : psychologue, psychomotricienne, intervenant culturel. Chacun garde son cadre professionnel, le jeu vidéo est le support commun.',
  },
  {
    id: 'restitution',
    q: 'Que reçoit la structure à la fin ?',
    a: 'Un document écrit, remis à l’équipe et discuté avec elle, dans une forme réutilisable pour vos rapports d’activité. Les éléments nominatifs restent à la structure : je ne publie rien qui identifie une famille.',
  },
  {
    id: 'devis',
    q: 'Sur quoi porte le devis ?',
    a: 'Sur devis, calibré au périmètre (nombre d’ateliers, nombre de familles, durée). Le devis inclut la rémunération du médiateur intervenant, le prêt des consoles et des jeux peut être inclus ou pris en charge par la structure.',
  },
]

// Déroulé en 4 étapes — activités : plaquette ; ancrage HCSP/HAS éditorial, cf. docs/references/CITATIONS.md
const steps = [
  { num: '01', title: 'Préparation', detail: 'Entretiens familiaux menés avec l’équipe pluridisciplinaire et le médiateur numérique : profil ludique de chaque enfant, usages et attentes des parents, construction des binômes parent-enfant. Le diagnostic partagé qui conditionne la suite.' },
  { num: '02', title: 'Ateliers thématiques parent-enfant', detail: 'Coopération · Émotions & récits · Différence & complémentarité — travaillés par le jeu vidéo comme support de médiation, jamais comme problème.' },
  { num: '03', title: 'Groupe de parole familiale', detail: 'Régulation, limites pour un usage régulé, repères d’usage problématique, posture parentale : l’accompagnement parental que le cadre HCSP désigne comme le facteur clé.' },
  { num: '04', title: 'Bilan', detail: 'Synthèse des acquis parent et enfant, pistes de continuité à la maison, transmission écrite à l’équipe — avec les recommandations HCSP mobilisées.' },
]

const frameworks = [
  { key: 'HCSP', year: '2019', title: 'Effets de l’exposition aux écrans', desc: 'L’accompagnement parental actif, facteur clé pour limiter les effets négatifs.', url: 'https://www.hcsp.fr/Explore.cgi/AvisRapportsDomaine?clefr=759' },
  { key: 'HCSP', year: '2020', title: 'De l’usage excessif à la dépendance', desc: 'Repères pour prévenir le basculement vers un usage problématique — calibration des indicateurs PXLC.', url: 'https://www.hcsp.fr/Explore.cgi/AvisRapportsDomaine?clefr=1074' },
]

// Indicateurs d'évaluation — source : plaquette §"Indicateurs d'évaluation".
// Suivis pendant le projet ; aucun résultat n'est publiable tant que l'équipe
// n'a pas validé le bilan.
const indicators = [
  { title: 'Questionnaires de satisfaction', detail: 'Recueillis en fin de chaque cycle auprès des parents et des enfants. Items standardisés + champ libre.' },
  { title: 'Grilles d’observation des compétences', detail: 'Coopération, communication, gestion des émotions — observées pendant les ateliers et restituées dans le bilan.' },
  { title: 'Diminution rapportée des conflits familiaux liés aux écrans', detail: 'Auto-évaluation parents, complétée par le suivi de l’équipe pluridisciplinaire entre les ateliers.' },
  { title: 'Engagement et assiduité aux ateliers', detail: 'Taux de présence, participation active, demandes de prolongation.' },
]

const seo = {
  title: 'Projets de médiation numérique en Guadeloupe',
  description: 'Le projet Parent-Écran-Enfant conduit au SESSAD Lékoklaya en 2026 — déroulé, thèmes d’atelier, indicateurs suivis.',
  ogDescription: 'Andy Zébus, créateur de PXLC, conduit des projets de médiation numérique auprès des familles en Guadeloupe.',
}

// WebPage typée FAQPage + nœuds Question — le Service #service global est
// référencé via `about` pour rattacher la page au graphe.
const schemaGraph = pageGraph({
  path: '/projets/',
  type: ['WebPage', 'FAQPage'],
  name: 'Projets de médiation numérique pour les lieux qui accueillent des familles',
  description: seo.description,
  aboutId: ID.service,
  crumbs: breadcrumbItems('/projets/'),
  questions: faqs,
})
---

<BaseLayout {...seo} schemaGraph={schemaGraph}>
  <section class="hero hero--soft" aria-labelledby="hero-title">
    <div class="hero__strip"><PxlcDuo /></div>
    <div class="container">
      <div class="hero__inner hero__inner--solo">
        <div>
          <SiteBreadcrumb />
          <h1 id="hero-title" class="hero__title">
            Les projets que je conduis avec votre équipe<span class="coral-dot" aria-hidden="true">.</span>
          </h1>
          <p class="hero__lead">
            Un projet en cours aujourd’hui, au SESSAD Lékoklaya. Cette page en détaille le déroulé, les thèmes de travail et ce que l’équipe reçoit à la fin.
          </p>
          <div class="hero__actions">
            <a href={IDENTITY.bookingUrl} target="_blank" rel="noopener noreferrer" class="btn btn--primary btn--lg" aria-label="Prendre rendez-vous (nouvel onglet)">Prendre rendez-vous</a>
            <a href="/files/plaquette-pxlc.pdf" target="_blank" rel="noopener noreferrer" class="btn btn--ghost btn--lg btn--no-arrow" aria-label="Plaquette PDF, 6 pages (nouvel onglet)">Plaquette PDF · 6 pages</a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section id="projets" class="section" aria-labelledby="projets-title">
    <div class="container">
      <header class="section__head">
        <span class="eyebrow">La rubrique</span>
        <h2 id="projets-title">Les projets menés<span class="coral-dot" aria-hidden="true">.</span></h2>
        <p class="lead">Chaque projet se construit avec un lieu qui accueille déjà des familles&nbsp;: il apporte le public, j’apporte l’atelier et le cadre.</p>
      </header>
      <div class:list={['projets-grid', { 'projets-grid--solo': PROJECTS.length === 1 }]}>
        {PROJECTS.map(p => (
          <article class="card projet-card" id={p.slug}>
            <div class="card__duo"><PxlcMark size={20} decorative /></div>
            <span class="badge badge--soft">{p.status} · {p.year}</span>
            <h3 class="projet-card__name mt-3">{p.name}</h3>
            <p class="projet-card__place">{p.localName && <Fragment>«&nbsp;{p.localName}&nbsp;» · </Fragment>}{p.place}</p>
            <p class="projet-card__summary mt-3">{p.summary}</p>
            <dl class="projet-card__facts mt-4">
              <div class="projet-card__row">
                <dt class="kicker">Porteur</dt>
                <dd>{p.owner}</dd>
              </div>
              <div class="projet-card__row">
                <dt class="kicker">Public</dt>
                <dd>{p.audience}</dd>
              </div>
              <div class="projet-card__row">
                <dt class="kicker">Équipe</dt>
                <dd>{p.team}</dd>
              </div>
              <div class="projet-card__row">
                <dt class="kicker">Cadre</dt>
                <dd>{p.framework}</dd>
              </div>
            </dl>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section id="jouons-ensemble" class="leko-section" aria-labelledby="jouons-ensemble-title">
    <PxlcDuo class="leko-section__strip" />
    <div class="container">
      <header class="section__head">
        <span class="eyebrow leko-eyebrow">Programme Parent-Écran-Enfant · SESSAD Lékoklaya · 2026</span>
        <h2 id="jouons-ensemble-title" class="leko-title">D’où vient ce projet<span class="coral-dot" aria-hidden="true">.</span></h2>
        <p class="lead leko-lead">Porté par le psychologue du SESSAD, dans la continuité du Café-Parents «&nbsp;Enfants Écrans&nbsp;» de décembre 2023.</p>
      </header>
      <div class="leko-prose">
        <p>Le point de départ&nbsp;: le jeu vidéo revenait systématiquement dans les entretiens familiaux comme source de conflit. Le projet transforme ces tensions en matériau de travail pour l’équipe pluridisciplinaire.</p>
        <p>Les parents qui ne comprennent pas pourquoi leur enfant joue rejouent avec lui. Les profils ludiques sont transmis à l’équipe dans le bilan.</p>
      </div>
    </div>
  </section>

  <section id="deroule" class="section" aria-labelledby="deroule-title">
    <div class="container">
      <header class="section__head">
        <span class="eyebrow">Déroulé du projet</span>
        <h2 id="deroule-title">Quatre étapes, de la préparation au bilan<span class="coral-dot" aria-hidden="true">.</span></h2>
        <p class="lead">Le déroulé de «&nbsp;Jouons Ensemble&nbsp;!&nbsp;», ancré dans le cadre HCSP&nbsp;2019-2020 · HAS&nbsp;2020&nbsp;: partir des usages réels de la famille, travailler par le jeu, outiller les parents, transmettre un bilan écrit à l’équipe.</p>
      </header>
      <div class="grid grid--2 process-grid">
        {steps.map(s => (
          <article class="card card--method">
            <div class="card__duo"><PxlcMark size={20} decorative /></div>
            <div class="card__step-num">ÉTAPE {s.num}</div>
            <h3>{s.title}</h3>
            <p>{s.detail}</p>
          </article>
        ))}
      </div>
      <div class="deroule-eval">
        <h3 class="deroule-eval__title">Évaluation &amp; restitution</h3>
        <p class="lead">Quatre indicateurs qualitatifs suivis tout au long du projet. Le bilan est en cours&nbsp;: les résultats seront publiés quand l’équipe les aura validés.</p>
        <div class="grid grid--2">
          {indicators.map(i => (
            <article class="card">
              <h4 class="indicator-title">{i.title}</h4>
              <p class="indicator-detail mt-3">{i.detail}</p>
            </article>
          ))}
        </div>
      </div>
    </div>
  </section>

  <section id="themes" class="section section--soft" aria-labelledby="themes-title">
    <div class="container">
      <header class="section__head">
        <span class="eyebrow">Ateliers du projet</span>
        <h2 id="themes-title">Trois thèmes d’atelier, un protocole<span class="coral-dot" aria-hidden="true">.</span></h2>
        <p class="lead">
          Les trois thèmes de «&nbsp;Jouons Ensemble&nbsp;!&nbsp;». Chaque atelier articule un temps de jeu partagé (30 à 45&nbsp;min) et un temps d’échange verbal (45&nbsp;min à 1&nbsp;h).
        </p>
      </header>
      <div class="grid grid--3">
        {themes.map(t => (
          <article class="card">
            <span class="kicker">Thème</span>
            <h3 class="mt-3 theme-title">{t.title}</h3>
            <p class="mt-3 theme-desc">{t.long}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section id="cadre" class="section" aria-labelledby="cadre-title">
    <div class="container">
      <header class="section__head">
        <span class="eyebrow">Cadre théorique</span>
        <h2 id="cadre-title">Deux rapports qui structurent la démarche<span class="coral-dot" aria-hidden="true">.</span></h2>
        <p class="lead">Pas un avis personnel&nbsp;: un cadre bâti sur les rapports du Haut Conseil de la santé publique (HCSP) et de la Haute Autorité de santé (HAS), cités explicitement dans chaque bilan.</p>
      </header>
      <div class="grid grid--2">
        {frameworks.map(c => (
          <article class="card">
            <div class="framework-tag">
              <span class="framework-tag__dot"></span>
              <span class="kicker framework-tag__label">{c.key} · {c.year}</span>
            </div>
            <h3 class="framework-title">{c.title}</h3>
            <p class="framework-desc">{c.desc}</p>
            {c.url
              ? <a
                  href={c.url}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="kicker mt-3 framework-meta framework-meta--link"
                  aria-label={`${c.key} ${c.year}, rapport officiel (nouvel onglet)`}
                >↳ rapport officiel ↗</a>
              : <span class="kicker mt-3 framework-meta">↳ référence officielle</span>}
          </article>
        ))}
      </div>
    </div>
  </section>

  <section id="faq" class="section section--soft" aria-labelledby="faq-title">
    <div class="container">
      <header class="section__head">
        <span class="eyebrow">FAQ</span>
        <h2 id="faq-title">Questions fréquentes<span class="coral-dot" aria-hidden="true">.</span></h2>
      </header>
      <div class="faq">
        {faqs.map(f => (
          <details class="faq__item">
            <summary class="faq__q">{f.q}</summary>
            <div class="faq__a">{f.a}</div>
          </details>
        ))}
      </div>
    </div>
  </section>

</BaseLayout>

<style>
  /* Le hero de cette page n'a pas de carte latérale : une seule colonne. */
  .hero__inner--solo { grid-template-columns: 1fr; }

  /* Page de liste : titre plafonné à 48px, la signature 64px reste
     réservée à l’accueil. */
  .hero__title { font-size: clamp(32px, 5.4vw, 48px); }

  /* ── Rubrique projets ── */
  .projets-grid { display: grid; gap: var(--space-4); grid-template-columns: repeat(auto-fit, minmax(320px, 1fr)); }
  /* Une carte seule ne flotte pas dans une grille prévue pour plusieurs. */
  .projets-grid--solo { grid-template-columns: 1fr; max-width: 820px; }
  .projet-card__name { font-size: 24px; }
  .projet-card__place { font-size: 15px; line-height: 1.6; color: var(--ink-quiet); }
  .projet-card__summary { font-size: 15px; line-height: 1.6; }
  .projet-card__facts { display: grid; gap: var(--space-3); margin: 0; }
  .projet-card__row {
    display: grid; gap: var(--space-1);
    padding-bottom: var(--space-3); border-bottom: 1px dashed var(--line);
  }
  .projet-card__row:last-child { border-bottom: 0; padding-bottom: 0; }
  .projet-card__row dd {
    margin: 0; font-family: var(--font-body); font-size: 15px;
    line-height: 1.5; color: var(--ink);
  }
  @media (min-width: 640px) {
    .projet-card__row { grid-template-columns: 120px 1fr; gap: var(--space-3); align-items: baseline; }
  }

  /* ── Déroulé : bloc évaluation & restitution (sous les 4 étapes) ── */
  .deroule-eval { margin-top: var(--space-6); }
  .deroule-eval__title { font-size: 20px; margin-bottom: var(--space-2); }

  .process-grid { align-items: stretch; }

  .framework-tag {
    display: inline-flex; align-items: center; gap: var(--space-2);
    background: var(--surface); border: 1px solid var(--line);
    padding: 6px 12px; border-radius: var(--radius-sm); margin-bottom: var(--space-3);
  }
  .framework-tag__dot { width: 8px; height: 8px; background: var(--pxlc-coral); border-radius: 2px; }
  .framework-tag__label { color: var(--ink); }
  .framework-title { font-size: 20px; margin-bottom: var(--space-2); }
  /* .pxlc-body-sm (global) — 15px / 1.6 avec font-body et ink-quiet. */
  .framework-desc,
  .indicator-detail,
  .theme-desc { font-size: 15px; line-height: 1.6; }

  .framework-meta { display: block; }
  .framework-meta--link { color: var(--parent); transition: color var(--dur-fast); }
  .framework-meta--link:hover { color: var(--pxlc-coral); text-decoration: none; }

  .indicator-title { font-size: 18px; }

  .theme-title { font-size: 20px; }

  .faq { display: grid; gap: var(--space-2-5); max-width: 820px; margin: 0 auto; }
  .faq__item {
    border: 1px solid var(--line); border-radius: var(--radius-md);
    background: var(--surface-raised); padding: 16px 20px;
    transition: border-color var(--dur-fast);
  }
  .faq__item[open] { border-color: var(--pxlc-coral); }
  .faq__q {
    font-family: var(--font-display); font-weight: 600; font-size: 16px;
    color: var(--ink); cursor: pointer; list-style: none;
    display: flex; align-items: center; justify-content: space-between; gap: var(--space-3);
  }
  .faq__q::after {
    content: "+"; font-family: var(--font-label); font-weight: 400;
    color: var(--pxlc-coral); font-size: 22px; transition: transform var(--dur-base);
  }
  .faq__item[open] .faq__q::after { content: "−"; }
  .faq__q::-webkit-details-marker { display: none; }
  .faq__a {
    margin-top: var(--space-2-5); font-size: 15px; line-height: 1.6; color: var(--ink-muted);
  }

  /* Lekoklaya dark section — casse la monotonie des sections standard */
  .leko-section {
    background: var(--pxlc-bg-dark); color: var(--pxlc-ivory);
    padding: clamp(var(--space-6), 8vw, var(--space-9)) 0;
    position: relative; overflow: hidden;
  }
  .leko-section :global(.leko-section__strip) { position: absolute; top: 32px; right: clamp(20px, 4vw, 56px); }
  .leko-eyebrow { color: var(--pxlc-cyan); }
  .leko-title { color: var(--pxlc-ivory); }
  .leko-lead { color: var(--pxlc-text-on-dark-soft); }
  .leko-prose { display: grid; gap: var(--space-3); max-width: 820px; }
  .leko-prose p { font-size: 15px; line-height: 1.6; color: var(--pxlc-text-on-dark-soft); margin: 0; }
</style>
