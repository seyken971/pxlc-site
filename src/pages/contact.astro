---
import BaseLayout from '../layouts/BaseLayout.astro'
import HeroSection from '../components/HeroSection.astro'
import CommuneMap from '../components/CommuneMap.astro'
import { IDENTITY } from '../config/identity'
import { ZONE } from '../config/site'
import { pageGraph } from '../lib/schema'
import { breadcrumbItems } from '../lib/breadcrumb'

const seo = {
  title: 'Contacter Andy Zébus — devis ou premier échange',
  description: 'Devis ou premier échange de 20\u00A0min — gratuit, sans engagement. Pour les structures qui accompagnent des familles.',
  ogDescription: 'Réponse sous 2\u00A0jours ouvrés. Premier échange de 20\u00A0min gratuit, en visio ou sur site, pour cadrer le projet.',
}

const schemaGraph = pageGraph({
  path: '/contact/',
  type: ['WebPage', 'ContactPage'],
  name: 'Contact PXLC',
  description: 'Page de prise de contact avec PXLC — Andy Zébus, médiateur numérique en Guadeloupe.',
  crumbs: breadcrumbItems('/contact/'),
})

// Demande de devis par e-mail : GitHub Pages ne traite pas de POST, et un
// formulaire qui ouvre la messagerie laissait croire à un envoi. Le lien
// mailto: est donc assumé comme tel — un modèle prérempli, construit au
// build, qui pose les questions de cadrage (gabarit relevé au benchmark).
const QUOTE_FIELDS = ['Structure', 'Type de structure', 'Public et nombre de familles', 'Période souhaitée', 'Téléphone']
const quoteBody = [...QUOTE_FIELDS.map(f => `${f}\u00A0: `), '', 'Votre projet\u00A0:', ''].join('\r\n')
const quoteHref = `mailto:${IDENTITY.email}?subject=${encodeURIComponent('Demande de devis — ')}&body=${encodeURIComponent(quoteBody)}`

const { address, openingHours } = IDENTITY
const hours = `du lundi au vendredi, ${parseInt(openingHours.opens)}\u00A0h – ${parseInt(openingHours.closes)}\u00A0h`
---

<BaseLayout {...seo} schemaGraph={schemaGraph}>
  <!-- Tête de page : gabarit commun. Funnel RDV-first (docs/seo-plan.md) :
       la réservation est l'action primaire, l'e-mail de devis juste en
       dessous sert ceux qui préfèrent écrire ; la réassurance suit le CTA. -->
  <HeroSection
    breadcrumb
    eyebrow="Contact"
    title="On en parle"
    titleDot
    titleMark={'\u00A0?'}
    lead={'Le plus simple\u00A0: un échange de 20\u00A0min, en visio ou sur site, pour parler de votre structure et du public accompagné. Vous préférez écrire\u00A0? Un modèle de demande vous attend juste en dessous.'}
    ctaPrimary={{ label: 'Réserver un échange de 20\u00A0min', href: IDENTITY.bookingUrl, external: true }}
  >
    <ul class="contact-assure" role="list">
      <li>Premier échange de 20&nbsp;min, gratuit</li>
      <li>Réponse sous 2&nbsp;jours ouvrés</li>
      <li>Sans engagement</li>
    </ul>
  </HeroSection>

  <section class="section" aria-labelledby="ecrire-title">
    <div class="container">
      <div class="contact-grid">

        <!-- ── Colonne gauche — écrire ou appeler ────────────── -->
        <div>
          <h2 id="ecrire-title" class="contact-h2">Vous préférez écrire&nbsp;?</h2>
          <p class="contact-note">Je réponds sous 2&nbsp;jours ouvrés.</p>

          <p class="contact-text">
            Votre messagerie s’ouvre avec une demande de devis à compléter&nbsp;: votre structure, le public accompagné, la période envisagée. Quelques lignes suffisent.
          </p>
          <a class="btn btn--secondary contact-quote" href={quoteHref}>Écrire une demande de devis</a>

          <dl class="contact-direct">
            <div>
              <dt>Pas de messagerie sur ce poste&nbsp;?</dt>
              <dd class="contact-direct__mail">
                <a href={`mailto:${IDENTITY.email}`}>{IDENTITY.email}</a>
                <button id="contact-copy" type="button" class="contact-copy">Copier l’adresse</button>
              </dd>
            </div>
            <div>
              <dt>Par téléphone</dt>
              <dd><a href={`tel:${IDENTITY.telephone}`}>{IDENTITY.telephoneDisplay}</a>, {hours}</dd>
            </div>
          </dl>

          <p class="contact-plaquette">
            <a
              href="/files/plaquette-pxlc.pdf" target="_blank" rel="noopener noreferrer"
              data-astro-prefetch="false"
              aria-label="Télécharger la plaquette à transmettre à votre direction (PDF, 6 pages, nouvel onglet)"
            >Télécharger la plaquette à transmettre à votre direction</a> (PDF, 6&nbsp;pages)
            ou <a href="/plaquette/">la lire en ligne</a>.
          </p>
        </div>

        <!-- ── Colonne droite — territoire + coordonnées ─────── -->
        <div class="contact-terr">
          <div class="contact-terr__head">
            <h2 class="contact-h2">Zone d’intervention</h2>
            <p class="contact-note">En présentiel à {ZONE.join(', ')}. Premier échange en visio ou sur site.</p>
          </div>
          <CommuneMap zone={[...ZONE]} label="Communes de Guadeloupe — zone d’intervention PXLC" />

          <div class="contact-terr__side">
            <span class="eyebrow">Coordonnées</span>
            <!-- NAP visible et indexable — doit correspondre à la fiche Google
                 Business Profile et au nœud schema.org #identity (signal local). -->
            <address class="contact-nap">
              <p class="contact-nap__name">{IDENTITY.brandName}</p>
              <p class="contact-nap__line">{address.street}</p>
              <p class="contact-nap__line">{address.postalCode} {address.locality}, {address.region}</p>
              <p class="contact-nap__line">{IDENTITY.telephoneDisplayIntl}</p>
            </address>
          </div>
        </div>

      </div>
    </div>
  </section>

  <!-- ── Ce qui se passe ensuite ────────────────────────────── -->
  <section class="section contact-steps" aria-labelledby="steps-title">
    <div class="container">
      <h2 id="steps-title" class="contact-h2">Ce qui se passe ensuite</h2>
      <p class="contact-note">Aucune étape n’engage à la suivante.</p>
      <ol class="contact-steps__grid" role="list" data-reveal-stagger>
        <li class="contact-step">
          <span class="contact-step__num" aria-hidden="true">01</span>
          <h3>Vous prenez contact</h3>
          <p>Vous réservez un créneau en ligne, ou vous m’écrivez&nbsp;: je reviens alors vers vous avec deux ou trois questions de cadrage.</p>
        </li>
        <li class="contact-step">
          <span class="contact-step__num" aria-hidden="true">02</span>
          <h3>On échange 20&nbsp;min</h3>
          <p>Visio ou sur site, pour parler de votre structure et du public accompagné.</p>
        </li>
        <li class="contact-step">
          <span class="contact-step__num" aria-hidden="true">03</span>
          <h3>Proposition écrite</h3>
          <p>Périmètre, calendrier et budget.</p>
        </li>
      </ol>
    </div>
  </section>
<script>
  import { IDENTITY } from '../config/identity'

  // Repli pour les postes sans logiciel de messagerie (ordinateur partagé,
  // webmail) : copier l'adresse. Silencieux si l'API n'est pas disponible —
  // l'adresse reste affichée en clair à côté.
  const copyBtn = document.getElementById('contact-copy')
  let copyTimer: ReturnType<typeof setTimeout> | undefined

  copyBtn?.addEventListener('click', async () => {
    try {
      await navigator.clipboard.writeText(IDENTITY.email)
      copyBtn.textContent = 'Copié'
      clearTimeout(copyTimer)
      copyTimer = setTimeout(() => { copyBtn.textContent = 'Copier l’adresse' }, 2000)
    }
    catch {
      // Presse-papiers indisponible — l'adresse reste lisible et sélectionnable.
    }
  })
</script>
</BaseLayout>

<style>
  /* ── Réassurance ─────────────────────────────────────────────── */
  .contact-assure {
    display: flex; flex-wrap: wrap;
    gap: var(--space-2-5) var(--space-5);
    /* Sous le CTA du hero : même respiration qu'entre chapô et actions. */
    margin: var(--space-4) 0 0; padding: 0; list-style: none;
    font-family: var(--font-label); font-size: var(--fs-small);
    color: var(--ink-muted);
  }
  .contact-assure li { display: flex; align-items: center; gap: 9px; }
  .contact-assure li::before {
    content: "";
    width: 6px; height: 6px; flex: 0 0 auto;
    background: var(--parent-mid);
    border-radius: 1px;
  }

  /* ── Titres de bloc ───────────────────────────────────────────── */
  .contact-h2 {
    font-size: var(--fs-title-3);
    line-height: var(--lh-title-3);
    letter-spacing: var(--ls-title-3);
    margin: 0 0 var(--space-1);
  }
  .contact-note {
    font-family: var(--font-body);
    font-size: var(--fs-small);
    color: var(--ink-quiet);
    margin: 0 0 var(--space-4);
  }

  /* ── Grille écrire / territoire ──────────────────────────────── */
  .contact-grid {
    display: grid;
    grid-template-columns: 1.35fr 1fr;
    gap: var(--space-6);
    align-items: start;
  }
  @media (max-width: 960px) {
    .contact-grid { grid-template-columns: 1fr; gap: var(--space-5); }
  }

  /* ── Écrire ou appeler ───────────────────────────────────────── */
  .contact-text {
    font-size: var(--fs-body); line-height: var(--lh-body);
    color: var(--ink-muted);
    margin: 0 0 var(--space-4); max-width: 52ch;
  }
  @media (max-width: 600px) {
    .contact-quote { width: 100%; justify-content: center; white-space: normal; }
  }

  .contact-direct {
    display: grid; gap: var(--space-3);
    margin: var(--space-5) 0 0; padding-top: var(--space-4);
    border-top: 1px solid var(--line);
  }
  .contact-direct dt {
    font-family: var(--font-label); font-size: var(--fs-small);
    color: var(--ink-quiet);
    margin-bottom: var(--space-1);
  }
  .contact-direct dd { margin: 0; font-size: var(--fs-body-sm); color: var(--ink-muted); }
  /* Souligné : lien dans du texte courant, la couleur seule ne suffit pas (RGAA 10.6). */
  .contact-direct a { color: var(--parent); font-weight: 600; text-decoration: underline; text-underline-offset: 3px; }
  .contact-direct a:hover { text-decoration-thickness: 2px; }
  .contact-direct__mail { display: flex; flex-wrap: wrap; align-items: center; gap: var(--space-2-5); }

  .contact-copy {
    font-family: var(--font-label); font-size: var(--fs-small); font-weight: 600;
    letter-spacing: 0.04em; color: var(--ink-muted);
    background: var(--surface-raised);
    border: 1px solid var(--line); border-radius: var(--radius-pill);
    padding: 0 var(--space-3); min-height: 44px; cursor: pointer;
    transition: color var(--dur-fast) var(--ease-out), border-color var(--dur-fast) var(--ease-out), transform var(--dur-fast) var(--ease-out);
  }
  .contact-copy:active { transform: scale(0.97); }
  @media (hover: hover) and (pointer: fine) {
    .contact-copy:hover { color: var(--parent); border-color: var(--parent); }
  }
  .contact-copy:focus-visible { outline: none; box-shadow: var(--focus-ring); }
  @media (prefers-reduced-motion: reduce) {
    .contact-copy { transition: none; }
    .contact-copy:active { transform: none; }
  }

  .contact-plaquette {
    margin: var(--space-4) 0 0;
    font-size: var(--fs-small); color: var(--ink-quiet);
  }
  .contact-plaquette a { color: var(--parent); text-decoration: underline; text-underline-offset: 3px; }

  /* ── Bloc territoire (carte + coordonnées) ───────────────────── */
  .contact-terr {
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
    overflow: hidden;
    background: var(--surface-raised);
  }
  @media (min-width: 961px) {
    /* Aligné sur scroll-padding-top (header sticky ≈ 81 px). */
    .contact-terr { position: sticky; top: 96px; }
  }
  .contact-terr__head { padding: var(--space-4) var(--space-4) 0; }
  .contact-terr__head .contact-note { margin-bottom: var(--space-3); }
  .contact-terr__side { padding: var(--space-4); border-top: 1px solid var(--line); }

  /* ── NAP (adresse visible) ───────────────────────────────────── */
  .contact-nap { font-style: normal; }
  .contact-nap__name {
    font-family: var(--font-display);
    font-weight: 600; font-size: var(--fs-body-sm);
    color: var(--ink);
    margin: 0 0 var(--space-1-5);
  }
  .contact-nap__line {
    font-family: var(--font-body);
    font-size: var(--fs-small); line-height: 1.55;
    color: var(--ink-muted);
    margin: 0;
  }

  /* ── Ce qui se passe ensuite ─────────────────────────────────── */
  .contact-steps { padding-top: 0; }
  .contact-steps__grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    margin: 0; padding: 0; list-style: none;
    border-top: 1px solid var(--line);
  }
  .contact-step {
    padding: var(--space-4) var(--space-5) var(--space-4) 0;
    border-right: 1px solid var(--line);
  }
  .contact-step + .contact-step { padding-left: var(--space-5); }
  .contact-step:last-child { border-right: 0; }
  .contact-step__num {
    display: block;
    font-family: var(--font-label);
    font-size: var(--fs-label); font-weight: 600;
    letter-spacing: var(--ls-label);
    color: var(--parent);
    margin-bottom: var(--space-2-5);
  }
  .contact-step h3 { font-size: var(--fs-body); margin: 0 0 var(--space-1-5); }
  .contact-step p {
    font-family: var(--font-body);
    font-size: var(--fs-small); line-height: 1.55;
    color: var(--ink-quiet);
    margin: 0; max-width: 30ch;
  }
  @media (max-width: 760px) {
    .contact-steps__grid { grid-template-columns: 1fr; }
    .contact-step { padding: var(--space-4) 0; border-right: 0; border-bottom: 1px solid var(--line); }
    .contact-step + .contact-step { padding-left: 0; }
    .contact-step:last-child { border-bottom: 0; }
  }
</style>
