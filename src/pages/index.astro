---
import BaseLayout from '../layouts/BaseLayout.astro'
import HeroSection from '../components/HeroSection.astro'
import PartnerStrip from '../components/PartnerStrip.astro'
import MethodGrid from '../components/MethodGrid.astro'
import type { MethodStep } from '../components/MethodGrid.astro'
import SessadCase from '../components/SessadCase.astro'
import CitationBlock from '../components/CitationBlock.astro'
import PxlcMarkSeparator from '../components/PxlcMarkSeparator.astro'
import { pageGraph } from '../lib/schema'
import { SITE } from '../config/site'
import andyEvent from '../assets/photos/andy-event.jpg'

// Méthode PXLC en trois temps — démarche comportementale alignée sur le rapport
// DITP/MILDECA 2022 (diagnostic → stratégie partagée → dialogue). Générique à
// toute structure — le programme détaillé (4 étapes Parent-Écran-Enfant) vit
// sur /projets.
const methodSteps: MethodStep[] = [
  { num: '01', title: 'Faire le point', desc: 'Je pars des usages réels de la famille — à quoi l’enfant joue, ce que l’écran représente. Observer avant de cadrer : la prise de conscience est déjà un levier.', tag: 'diagnostic' },
  { num: '02', title: 'Choisir une stratégie', desc: 'La famille co-construit ses repères d’usage. L’enfant participe au choix des règles, ce qui désamorce les conflits plutôt que de les déplacer.', tag: 'stratégie' },
  { num: '03', title: 'Dialogue continu', desc: 'Le cadre devient une clé d’explication impartiale : il ouvre la discussion parent-enfant au lieu de la fermer, et tient dans la durée.', tag: 'suivi' },
]

// Trois repères, pas un tableau de bord : la structure partenaire est déjà
// nommée par le bandeau PartnerStrip juste en dessous.
const stats = [
  { value: '8', label: 'familles accompagnées en 2026' },
  { value: '6 ans', label: 'sur la scène esport guadeloupéenne' },
  { value: 'HCSP · HAS', label: 'cadre de référence\u00A0: HCSP\u00A02019-2020 · HAS\u00A02020' },
]

const seo = {
  title: 'Écrans en famille : médiation numérique en Guadeloupe',
  description: 'Médiation numérique en Guadeloupe : Andy Zébus aide les structures à accompagner les familles autour des écrans.',
  ogDescription: SITE.description,
}

// WebPage d'accueil rattachée au nœud #website — alignée sur les autres pages.
const schemaGraph = pageGraph({
  path: '/',
  name: seo.title,
  description: seo.description,
})
---

<BaseLayout {...seo} schemaGraph={schemaGraph}>
  <HeroSection
    eyebrow="Écrans en famille · Guadeloupe"
    title="Médiation numérique en Guadeloupe"
    titleDot={true}
    lead={'J’aide les structures en Guadeloupe à accompagner les familles autour des écrans. Concrètement : résolution des conflits autour du temps d’écran, bonnes pratiques du numérique.'}
    ctaPrimary={{ label: 'Voir les projets', href: '/projets/' }}
    ctaSecondary={{ label: 'Plaquette PDF · 6 pages', href: '/files/plaquette-pxlc.pdf', external: true }}
    ctaSecondaryAlt={{ label: 'Lire en ligne', href: '/plaquette/', ariaLabel: 'Lire en ligne (plaquette, version web accessible)' }}
    photo={andyEvent}
    photoAlt="Andy Zébus en animation lors d’un événement de jeu vidéo en Guadeloupe"
  />
  <section class="section reperes-section" aria-labelledby="reperes-title">
    <div class="container">
      <h2 id="reperes-title" class="eyebrow">Quelques repères</h2>
      <ul class="reperes" role="list" data-reveal-stagger>
        {stats.map(s => (
          <li class="repere">
            <span class="repere__value">{s.value}</span>
            <span class="repere__label">{s.label}</span>
          </li>
        ))}
      </ul>
    </div>
  </section>
  <PartnerStrip />
  <MethodGrid steps={methodSteps} />
  <PxlcMarkSeparator />
  <SessadCase />
  <CitationBlock
    source={'« Jouons Ensemble ! » · projet 2026'}
    quote="Jouer ensemble, c’est mieux comprendre, mieux se parler, et mieux grandir."
    attribution="Devise du projet · SESSAD Lékoklaya × PXLC"
  />
</BaseLayout>

<style>
  /* Bandeau éditorial : trois repères séparés par des filets neutres, en
     ligne sur bureau, en rangées sur mobile — pas de chiffres façon tableau
     de bord. */
  .reperes-section { padding-block: var(--space-6); }
  .reperes {
    display: grid;
    grid-template-columns: 1fr;
    margin: var(--space-3) 0 0;
    padding: 0;
    list-style: none;
    border-block: 1px solid var(--line);
  }
  .repere {
    display: grid;
    grid-template-columns: minmax(0, 8.5rem) 1fr;
    align-items: baseline;
    gap: var(--space-3);
    padding-block: var(--space-3);
  }
  .repere + .repere { border-top: 1px solid var(--line); }
  @media (min-width: 768px) {
    .reperes { grid-template-columns: repeat(3, 1fr); }
    .repere { grid-template-columns: 1fr; gap: var(--space-1-5); padding: var(--space-4) var(--space-4) var(--space-4) 0; }
    .repere + .repere { border-top: 0; border-left: 1px solid var(--line); padding-left: var(--space-4); }
  }
  .repere__value {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: var(--fs-title-3);
    line-height: var(--lh-title-3);
    letter-spacing: var(--ls-title-3);
    color: var(--ink);
  }
  @media (min-width: 768px) {
    .repere__value { font-size: var(--fs-title-2); line-height: var(--lh-title-2); letter-spacing: var(--ls-title-2); }
  }
  .repere__label { font-family: var(--font-body); font-size: var(--fs-small); line-height: var(--lh-small); color: var(--ink-muted); }
</style>
