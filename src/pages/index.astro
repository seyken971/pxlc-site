---
import BaseLayout from '../layouts/BaseLayout.astro'
import HeroSection from '../components/HeroSection.astro'
import MethodGrid from '../components/MethodGrid.astro'
import type { MethodStep } from '../components/MethodGrid.astro'
import SessadCase from '../components/SessadCase.astro'
import PxlcLinkout from '../components/PxlcLinkout.astro'
import { pageGraph } from '../lib/schema'
import { SITE, ZONE } from '../config/site'
import { IDENTITY } from '../config/identity'
import andyEvent from '../assets/photos/andy-event.jpg'

// L'accueil suit les questions d'une structure qui découvre PXLC : pour qui,
// comment, concrètement quoi, avec quelle preuve. Un fait = un endroit.

// Les structures clientes, regroupées par famille (liste « Clients » du
// design system). Les familles sont bénéficiaires, pas clientes.
const audiences = [
  { title: 'Lecture publique et vie sociale', items: ['Médiathèques et bibliothèques', 'Centres sociaux et espaces de vie sociale', 'CCAS et dispositifs de réussite éducative'] },
  { title: 'Éducation et parentalité', items: ['Écoles et centres socioculturels', 'Dispositifs CLAS', 'Lieux d’accueil enfants-parents (LAEP)'] },
  { title: 'Médico-social', items: ['SESSAD', 'IME', 'CMPP', 'CAMSP'] },
]

// Méthode PXLC en trois temps — démarche comportementale alignée sur le rapport
// DITP/MILDECA 2022 (diagnostic → stratégie partagée → dialogue). Générique à
// toute structure — le déroulé appliqué (4 étapes Parent-Écran-Enfant, mêmes
// trois temps) vit sur /projets/#deroule.
const methodSteps: MethodStep[] = [
  { num: '01', title: 'Faire le point', desc: 'Je pars des usages réels de la famille — à quoi l’enfant joue, ce que l’écran représente. Observer avant de cadrer : la prise de conscience est déjà un levier.', tag: 'diagnostic' },
  { num: '02', title: 'Choisir une stratégie', desc: 'La famille co-construit ses repères d’usage. L’enfant participe au choix des règles, ce qui désamorce les conflits plutôt que de les déplacer.', tag: 'stratégie' },
  { num: '03', title: 'Dialogue continu', desc: 'Le cadre devient une clé d’explication impartiale : il ouvre la discussion parent-enfant au lieu de la fermer, et tient dans la durée.', tag: 'suivi' },
]

// L'essentiel d'une intervention — uniquement des faits déjà publiés
// (plaquette, FAQ de /projets/, page contact). Tarif et nombre de séances :
// aucun chiffre tant qu'Andy ne l'a pas fixé.
const practice = [
  { label: 'Format', value: 'Ateliers parent-enfant, conduits avec l’équipe de votre structure' },
  { label: 'Une séance', value: 'Un temps de jeu partagé (30 à 45 min), puis un temps d’échange (45 min à 1 h)' },
  { label: 'Restitution', value: 'Un bilan écrit, remis à l’équipe et discuté avec elle, réutilisable dans vos rapports d’activité' },
  { label: 'Cadre', value: 'HCSP 2019-2020 · HAS 2020' },
  { label: 'Matériel', value: 'Consoles et jeux prêtés, ou pris en charge par la structure' },
  { label: 'Zone', value: ZONE.join(', ') },
  { label: 'Tarif', value: 'Sur devis, selon le nombre d’ateliers, de familles et la durée' },
  { label: 'Pour commencer', value: 'Un premier échange de 20 min, gratuit et sans engagement' },
]

const seo = {
  title: 'Écrans en famille : médiation numérique en Guadeloupe',
  description: 'Médiation numérique en Guadeloupe : Andy Zébus aide les structures à accompagner les familles autour des écrans.',
  ogDescription: SITE.description,
}

// WebPage d'accueil rattachée au nœud #website — alignée sur les autres pages.
const schemaGraph = pageGraph({
  path: '/',
  name: seo.title,
  description: seo.description,
})
---

<BaseLayout {...seo} schemaGraph={schemaGraph}>
  <HeroSection
    eyebrow="Écrans en famille · Guadeloupe"
    title="Médiation numérique en Guadeloupe"
    titleDot={true}
    lead={'J’aide les structures en Guadeloupe à accompagner les familles autour des écrans. Concrètement : résolution des conflits autour du temps d’écran, bonnes pratiques du numérique.'}
    ctaPrimary={{ label: 'Prendre rendez-vous', href: IDENTITY.bookingUrl, external: true }}
    ctaSecondary={{ label: 'Voir les projets', href: '/projets/' }}
    ctaSecondaryAlt={{ label: 'Lire la plaquette en ligne', href: '/plaquette/' }}
    photo={andyEvent}
    photoAlt="Andy Zébus en animation lors d’un événement de jeu vidéo en Guadeloupe"
  />

  <section class="section" aria-labelledby="pour-qui-title">
    <div class="container">
      <header class="section__head">
        <span class="eyebrow">Pour qui</span>
        <h2 id="pour-qui-title">Les structures qui accueillent déjà des familles</h2>
        <p class="lead">Le lieu apporte le public, j’apporte l’atelier et le cadre. Je viens en appui de votre équipe, pas à sa place.</p>
      </header>
      <div class="audiences" data-reveal-stagger>
        {audiences.map(a => (
          <div class="audience">
            <h3 class="audience__title">{a.title}</h3>
            <ul class="audience__list" role="list">
              {a.items.map(item => <li>{item}</li>)}
            </ul>
          </div>
        ))}
      </div>
    </div>
  </section>

  <MethodGrid steps={methodSteps} more={{ label: 'Voir ces trois temps appliqués au SESSAD Lékoklaya', href: '/projets/#deroule' }} />

  <section class="section section--soft" aria-labelledby="pratique-title">
    <div class="container">
      <header class="section__head">
        <span class="eyebrow">En pratique</span>
        <h2 id="pratique-title">Ce que comprend une intervention</h2>
        <p class="lead">Un cycle d’ateliers parent-enfant conduit avec votre équipe, du diagnostic familial au bilan écrit. Le jeu vidéo en est le support, jamais le problème à résoudre.</p>
      </header>
      <dl class="facts" data-reveal-stagger>
        {practice.map(f => (
          <div><dt>{f.label}</dt><dd>{f.value}</dd></div>
        ))}
      </dl>
      <div class="pratique-more">
        <PxlcLinkout href="/contact/">Décrire votre projet pour recevoir un devis</PxlcLinkout>
      </div>
    </div>
  </section>

  <SessadCase />
</BaseLayout>

<style>
  /* Pour qui : trois familles de structures en colonnes à filet haut,
     sans cartes — une liste à lire, pas des boutons. */
  .audiences { display: grid; grid-template-columns: 1fr; gap: var(--space-4); }
  @media (min-width: 768px) { .audiences { grid-template-columns: repeat(3, 1fr); gap: var(--space-5); } }
  .audience { padding-top: var(--space-3); border-top: 2px solid var(--parent-mid); }
  .audience__title { font-size: var(--fs-lead); line-height: 1.3; margin-bottom: var(--space-2-5); }
  .audience__list { list-style: none; margin: 0; padding: 0; display: grid; gap: var(--space-1-5); }
  .audience__list li { font-size: var(--fs-body-sm); line-height: var(--lh-body-sm); color: var(--ink-muted); }

  .pratique-more { margin-top: var(--space-5); }
</style>
