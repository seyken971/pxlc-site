---
// Legal / informational page — indexable : elle porte le NAP et engage
// l’entité, donc elle a sa place dans l’index et dans le sitemap.
import BaseLayout from '../layouts/BaseLayout.astro'
import HeroSection from '../components/HeroSection.astro'
import PxlcMark from '../components/PxlcMark.astro'
import PxlcMarkSeparator from '../components/PxlcMarkSeparator.astro'
import { pageGraph } from '../lib/schema'
import { IDENTITY } from '../config/identity'

// Date de dernière mise à jour du contenu légal — à mettre à jour à la main
// (pas la date du build).
const lastUpdated = new Intl.DateTimeFormat('fr-FR', { day: 'numeric', month: 'long', year: 'numeric' })
  .format(new Date('2026-09-06T12:00:00'))

const seo = {
  title: 'Mentions légales',
  description: 'Mentions légales et coordonnées de PXLC — Andy Zébus, Entrepreneur Individuel.',
}

const schemaGraph = pageGraph({
  path: '/mentions-legales/',
  name: seo.title,
  description: seo.description,
})
---

<BaseLayout {...seo} schemaGraph={schemaGraph}>
  <!-- ── Hero ──────────────────────────────────────────────── -->
  <HeroSection
    breadcrumb
    breadcrumbLabel="Mentions légales"
    eyebrow="Informations légales"
    title="Mentions légales"
    titleDot
  >
    <p slot="lead">Conformément à la loi pour la confiance dans l'économie numérique du 21 juin 2004, voici les informations relatives à l'éditeur, à l'hébergeur et au traitement des données du site <strong>pxlc.fr</strong>.</p>
  </HeroSection>

  <!-- ── Content ───────────────────────────────────────────── -->
  <section class="section">
    <div class="container legal-container">

      <!-- Éditeur — carte branded -->
      <div class="legal-card">
        <PxlcMark size={20} decorative class="card__mark legal-card__corner" />
        <h2 class="legal-card__label">Éditeur du site</h2>
        <div class="legal-card__name">Andy Zébus — Entrepreneur Individuel</div>
        <dl class="legal-dl">
          <div class="legal-dl__row">
            <dt>Nom commercial</dt>
            <dd>PXLC</dd>
          </div>
          <div class="legal-dl__row">
            <dt>Adresse</dt>
            <dd>{IDENTITY.address.street} — {IDENTITY.address.postalCode} {IDENTITY.address.locality}, {IDENTITY.address.region} ({IDENTITY.address.country})</dd>
          </div>
          <div class="legal-dl__row">
            <dt>SIRET</dt>
            <dd><code>{IDENTITY.siret}</code></dd>
          </div>
          <div class="legal-dl__row">
            <dt>RCS</dt>
            <dd>{IDENTITY.rcsCity} — <code>{IDENTITY.siren}</code></dd>
          </div>
          <div class="legal-dl__row">
            <dt>Code APE</dt>
            <dd><code>{IDENTITY.ape}</code> — {IDENTITY.apeLabel}</dd>
          </div>
          <div class="legal-dl__row">
            <dt>Responsable de la publication</dt>
            <dd>Andy Zébus</dd>
          </div>
          <div class="legal-dl__row">
            <dt>Téléphone</dt>
            <dd><a href={`tel:${IDENTITY.telephone}`}>{IDENTITY.telephoneDisplay}</a></dd>
          </div>
          <div class="legal-dl__row">
            <dt>Email</dt>
            <dd><a href={`mailto:${IDENTITY.email}`}>{IDENTITY.email}</a></dd>
          </div>
          <div class="legal-dl__row">
            <dt>LinkedIn</dt>
            <dd>
              <a href="https://www.linkedin.com/in/azebus" target="_blank" rel="noopener noreferrer">
                linkedin.com/in/azebus
              </a>
            </dd>
          </div>
        </dl>
      </div>

      <PxlcMarkSeparator />

      <article class="prose">
        <h2>Hébergement</h2>
        <p>
          Le site est hébergé par <strong>GitHub, Inc.</strong> (88 Colin P. Kelly Jr. Street,
          San Francisco, CA 94107, États-Unis —
          <a href="https://github.com" target="_blank" rel="noopener noreferrer">github.com</a>)
          et servi via <em>GitHub Pages</em>, sans publicité ni traceurs additionnels.
        </p>

        <h2>Propriété intellectuelle</h2>
        <p>
          L'ensemble des contenus de ce site (textes, marques, logos, photographies, illustrations, design)
          est la propriété exclusive d'Andy Zébus, sauf mention contraire&nbsp;: toute reproduction ou diffusion,
          intégrale ou partielle, est interdite sans autorisation écrite préalable. Les recommandations
          institutionnelles citées (HCSP, HAS) demeurent la propriété de leurs auteurs respectifs.
        </p>

        <h2 id="rgpd">Données personnelles et cookies</h2>
        <p>
          Le site pxlc.fr ne dépose aucun cookie de traçage publicitaire ni d'analytics tiers. Seul un
          élément de stockage local (<code>localStorage</code>, clé <code>pxlc-theme</code>) mémorise votre
          préférence de thème&nbsp;; il ne quitte jamais votre navigateur. Le formulaire de contact envoie
          votre message via la boîte mail <a href="mailto:contact@pxlc.fr">contact@pxlc.fr</a>&nbsp;;
          aucune donnée n'est stockée sur un serveur tiers à cette occasion.
        </p>
        <p>
          Lorsque vous me contactez par email ou via <a href={IDENTITY.bookingUrl} target="_blank" rel="noopener noreferrer">{IDENTITY.bookingUrlDisplay}</a>,
          je conserve vos coordonnées au plus pendant 3 ans à compter du dernier échange. La prise de
          rendez-vous passe par Vyte (Vyte.in SAS, Paris), qui héberge les réservations en France. Conformément au
          règlement européen 2016/679 (RGPD), vous disposez des droits d'accès, de rectification, d'effacement,
          de portabilité et d'opposition sur vos données&nbsp;: écrivez à <a href="mailto:contact@pxlc.fr">contact@pxlc.fr</a>.
        </p>

        <p class="kicker legal-updated">
          Dernière mise à jour&nbsp;: {lastUpdated}
        </p>
      </article>
    </div>
  </section>
</BaseLayout>

<style>
  /* ── Content container ────────────────────────────────────────── */
  .legal-container { max-width: 760px; }

  /* ── Éditeur card ─────────────────────────────────────────────── */
  .legal-card {
    position: relative;
    background: var(--surface-raised);
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
    padding: var(--space-5);
    transition: background var(--dur-base);
  }

  /* Surcharge de positionnement pour .card__mark. */
  .legal-card :global(.legal-card__corner) {
    top: var(--space-4);
    right: var(--space-4);
  }

  .legal-card__label {
    font-family: var(--font-label);
    font-size: var(--fs-label);
    font-weight: 600;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--parent);
    margin: 0 0 var(--space-2);
  }

  .legal-card__name {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: var(--fs-lead);
    color: var(--ink);
    margin-bottom: var(--space-4);
  }

  /* ── DL tableau ───────────────────────────────────────────────── */
  .legal-dl {
    display: grid;
    gap: var(--space-2-5);
    margin: 0;
  }

  .legal-dl__row {
    display: grid;
    grid-template-columns: 140px 1fr;
    gap: var(--space-3);
    align-items: baseline;
  }
  @media (max-width: 520px) {
    .legal-dl__row {
      grid-template-columns: 1fr;
      gap: var(--space-1);
    }
  }

  .legal-dl dt {
    font-family: var(--font-label);
    font-size: var(--fs-label);
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--ink-quiet);
  }

  .legal-dl dd {
    font-size: var(--fs-small);
    color: var(--ink-muted);
    margin: 0;
  }

  .legal-dl dd code {
    font-family: var(--font-label);
    font-size: var(--fs-small);
    color: var(--parent);
    background: var(--surface-soft);
    padding: 1px 6px;
    border-radius: var(--radius-xs);
  }

  /* ── Updated kicker ───────────────────────────────────────────── */
  .legal-updated { display: block; margin-top: var(--space-6); }
</style>
