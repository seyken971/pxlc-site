---
// Page 404 de marque, servie par GitHub Pages (dist/404.html). Volontairement
// autonome : pas de BaseLayout, donc ni header, ni footer, ni CTA.
import '../styles/fonts.css'
import '../styles/styles.css'
import { SITE } from '../config/site'
import { THEME_SCRIPT } from '../lib/theme-script'
import PxlcLockup from '../components/PxlcLockup.astro'
---

<html lang={SITE.lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <!-- Anti-flash thème (pas d'héritage du layout ici). -->
    <script is:inline set:html={THEME_SCRIPT} />
    <title>Page introuvable · PXLC</title>
    <!-- 404 → noindex (hygiène SEO standard pour les vraies pages absentes). -->
    <meta name="robots" content="noindex, follow" />
    <link rel="shortcut icon" href="/favicon.ico" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  </head>
  <body>
    <main id="main" class="errpage">
      <div class="container errpage__inner">
        <PxlcLockup size="md" href="/" class="errpage__brand" />
        <span class="eyebrow">Erreur 404</span>
        <h1 class="errpage__title">
          Page introuvable<span class="coral-dot" aria-hidden="true">.</span>
        </h1>
        <p class="lead errpage__lead">Cette page n'existe pas ou a été déplacée. Le reste du site est bien là.</p>
        <div class="errpage__actions">
          <a class="btn btn--primary btn--no-arrow" href="/">
            Retour à l'accueil
          </a>
        </div>
      </div>
    </main>
  </body>
</html>

<style>
  .errpage {
    min-height: 80vh;
    display: flex;
    align-items: center;
    background: var(--surface);
    padding: clamp(48px, 8vw, 96px) 0;
    transition: background var(--dur-base);
  }

  .errpage__inner { max-width: 560px; }

  .errpage :global(.errpage__brand) { margin-bottom: var(--space-6); }

  .errpage__title {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: var(--fs-title-1);
    letter-spacing: var(--ls-title-1);
    line-height: var(--lh-title-1);
    margin: 0 0 var(--space-4);
    color: var(--ink);
  }

  .errpage__lead {
    max-width: 480px;
    margin-bottom: var(--space-5);
  }

  .errpage__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
  }
</style>
